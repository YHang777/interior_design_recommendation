  Widget _buildColorVariation(Color baseColor, String label) {
    return Column(
      children: [
        Container(
          width: 30,
          height: 30,
          decoration: BoxDecoration(
            color: baseColor,
            borderRadius: BorderRadius.circular(6),
            border: Border.all(color: Colors.grey.shade300),
