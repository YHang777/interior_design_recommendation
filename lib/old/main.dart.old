void main() {
  runApp(const InteriorDesignApp());
}

// Simple AuthProvider for demonstration
class AuthProvider extends ChangeNotifier {
  String? _role; // 'homeowner' or 'supplier'
  bool _loggedIn = false;

  String? get role => _role;
  bool get loggedIn => _loggedIn;

  void login(String role) {
    _role = role;
    _loggedIn = true;
    notifyListeners();
  }

  void logout() {
    _role = null;
    _loggedIn = false;
    notifyListeners();
  }
}



class InteriorDesignApp extends StatelessWidget {
  const InteriorDesignApp({Key? key}) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return MultiProvider(
      providers: [
        ChangeNotifierProvider(create: (_) => AuthProvider()),
        ChangeNotifierProvider(create: (_) => AnalyticsProvider()),
        ChangeNotifierProvider(create: (_) => MarketplaceProvider()..fetchProducts()),
      ],
      child: MaterialApp(
        title: 'Interior Design Recommendation',
        theme: ThemeData(
          useMaterial3: true,
          brightness: Brightness.light,
          primaryColor: const Color(0xFFBCAAA4), // soft brown
          scaffoldBackgroundColor: const Color(0xFFF8F6F1),
          colorScheme: ColorScheme.light(
            primary: const Color(0xFFBCAAA4), // soft brown
            secondary: const Color(0xFF80CBC4), // teal accent
            background: const Color(0xFFF8F6F1),
            surface: Colors.white,
            onPrimary: Colors.white,
            onSecondary: Colors.white,
            onBackground: Colors.brown.shade900,
            onSurface: Colors.brown.shade900,
          ),
          appBarTheme: AppBarTheme(
            backgroundColor: const Color(0xFFBCAAA4),
            foregroundColor: Colors.white,
            elevation: 0,
            titleTextStyle: GoogleFonts.poppins(
              color: Colors.white,
              fontWeight: FontWeight.bold,
              fontSize: 22,
            ),
          ),
          textTheme: GoogleFonts.poppinsTextTheme(
            Theme.of(context).textTheme.apply(
              bodyColor: Colors.brown.shade900,
              displayColor: Colors.brown.shade900,
            ),
          ),
          cardTheme: CardTheme(
            color: Colors.white,
            elevation: 4,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(18),
            ),
            margin: const EdgeInsets.symmetric(vertical: 8, horizontal: 0),
          ),
          elevatedButtonTheme: ElevatedButtonThemeData(
            style: ElevatedButton.styleFrom(
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
              textStyle: GoogleFonts.poppins(fontWeight: FontWeight.w600),
              elevation: 2,
              padding: const EdgeInsets.symmetric(vertical: 14, horizontal: 24),
              backgroundColor: const Color(0xFF80CBC4), // teal accent
              foregroundColor: Colors.white,
            ),
          ),
          outlinedButtonTheme: OutlinedButtonThemeData(
            style: OutlinedButton.styleFrom(
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
              textStyle: GoogleFonts.poppins(fontWeight: FontWeight.w600),
              side: const BorderSide(color: Color(0xFFBCAAA4)),
              foregroundColor: const Color(0xFFBCAAA4),
            ),
          ),
          inputDecorationTheme: InputDecorationTheme(
            filled: true,
            fillColor: Colors.brown.shade50,
            border: OutlineInputBorder(
              borderRadius: BorderRadius.circular(14),
              borderSide: BorderSide.none,
            ),
            focusedBorder: OutlineInputBorder(
              borderRadius: BorderRadius.circular(14),
              borderSide: const BorderSide(color: Color(0xFF80CBC4), width: 2),
            ),
            labelStyle: GoogleFonts.poppins(color: Colors.brown.shade700),
            hintStyle: GoogleFonts.poppins(color: Colors.brown.shade300),
          ),
          iconTheme: IconThemeData(color: Colors.brown.shade400, size: 28),
          floatingActionButtonTheme: const FloatingActionButtonThemeData(
            backgroundColor: Color(0xFF80CBC4),
            foregroundColor: Colors.white,
            shape: StadiumBorder(),
          ),
        ),
        debugShowCheckedModeBanner: false,
        home: const RootScreen(),
      ),
    );
  }
}

class RootScreen extends StatelessWidget {
  const RootScreen({Key? key}) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return Consumer<AuthProvider>(
      builder: (context, auth, _) {
        if (!auth.loggedIn) {
          return const AuthScreen();
        } else if (auth.role == 'homeowner') {
          return const HomeownerMainScreen();
        } else if (auth.role == 'supplier') {
          return const SupplierMainScreen();
        } else {
          return const AuthScreen();
        }
      },
    );
  }
}

