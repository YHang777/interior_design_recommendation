  // Task 3.2: Enhanced color option with selection
  Widget _buildColorOption(Color color) {
    final isSelected = _selectedWallColor == color;
    
    return GestureDetector(
      onTap: () {
        setState(() {
          _selectedWallColor = color;
          // Apply color to selected wall area
          if (_selectedWallArea != null) {
            final index = _wallAreas.indexWhere((w) => w.id == _selectedWallArea!.id);
            if (index != -1) {
              _wallAreas[index] = _selectedWallArea!.copyWith(color: color);
              ScaffoldMessenger.of(context).showSnackBar(
                SnackBar(content: Text('Applied ${color.toString()} to selected wall')),
              );
            } else {
              ScaffoldMessenger.of(context).showSnackBar(
                SnackBar(content: Text('No wall area selected. Please select a wall first.')),
              );
            }
          } else {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(content: Text('No wall area selected. Please select a wall first.')),
            );
          }
        });
      },
      child: Container(
        width: 40,
        height: 40,
        decoration: BoxDecoration(
          color: color,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(
            color: isSelected ? Colors.blue : Colors.grey.shade300,
            width: isSelected ? 2 : 1,
          ),
        ),
        child: isSelected
            ? const Icon(Icons.check, color: Colors.white, size: 20)
            : null,
