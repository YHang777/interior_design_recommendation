                      description: 'Contemporary LED floor lamp with dimmer',
                    ),
                    const design_report.DesignFurniture(
                      name: 'Wall Art Set',
                      category: 'Decor',
                      price: 450.00,
                      description: 'Set of 3 abstract wall art pieces',
                    ),
                    const design_report.DesignFurniture(
                      name: 'Storage Cabinet',
                      category: 'Storage',
                      price: 1200.00,
                      description: 'Multi-compartment storage cabinet',
                    ),
