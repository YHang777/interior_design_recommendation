  // Task 2.2 & 3.6: Drag & drop handlers with wall selection
  void _handleCanvasTap(Offset position) {
    if (_wallSelectionMode) {
      // Create new wall area at grid position
      _createWallAreaAtPosition(position);
    } else {
      // Task 3.6: Check for wall area selection (only selectable areas)
      final wallArea = _findWallAreaAtPosition(position);
      if (wallArea != null && wallArea.isSelectable) {
        setState(() {
          _selectedWallArea = wallArea;
          _selectedFurniture = null;
        });
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Selected wall area: ${wallArea.id}')),
        );
      } else {
        // Deselect furniture and wall area when tapping empty area
        setState(() {
          _selectedFurniture = null;
          _selectedWallArea = null;
        });
      }
    }
  }

  // Create wall area at grid position
  void _createWallAreaAtPosition(Offset position) {
    const gridSize = 50.0;
    final gridX = (position.dx / gridSize).floor();
    final gridY = (position.dy / gridSize).floor();
    final wallId = 'wall_${gridX}_${gridY}';
    
    // Check if wall area already exists
    final existingWall = _wallAreas.where((w) => w.id == wallId).firstOrNull;
    if (existingWall != null) {
      // Remove existing wall area
      setState(() {
        _wallAreas.removeWhere((w) => w.id == wallId);
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Removed wall area: $wallId')),
      );
    } else {
      // Create new wall area
      final newWallArea = _WallArea(
        id: wallId,
        bounds: Rect.fromLTWH(gridX * gridSize, gridY * gridSize, gridSize, gridSize),
        color: Colors.white,
        isSelectable: true,
      );
      setState(() {
        _wallAreas.add(newWallArea);
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Created wall area: $wallId')),
      );
    }
  }

  void _handleDragUpdate(DragUpdateDetails details) {
    if (_draggingFurniture != null) {
      setState(() {
        _dragPosition = details.localPosition;
      });
    }
  }

  void _handleDragEnd() {
    if (_draggingFurniture != null && _dragPosition != null) {
      // Task 2.3: Snap to grid
      final snappedPosition = _snapToGrid(_dragPosition!);
      
      // Add furniture to placed items
      final newFurniture = _PlacedFurniture(
        id: DateTime.now().millisecondsSinceEpoch.toString(),
        item: _draggingFurniture!,
        position: snappedPosition,
      );
      
      setState(() {
        _placedFurniture.add(newFurniture);
        _draggingFurniture = null;
        _dragPosition = null;
      });
      
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Placed ${_draggingFurniture!.name}')),
      );
    }
  }

  // Task 2.3: Snap to grid system
  Offset _snapToGrid(Offset position) {
    const gridSize = 20.0;
    final snappedX = (position.dx / gridSize).round() * gridSize;
    final snappedY = (position.dy / gridSize).round() * gridSize;
    return Offset(snappedX, snappedY);
  }

  // Task 2.2: Build placed furniture widget
  Widget _buildPlacedFurniture(_PlacedFurniture furniture) {
    final isSelected = _selectedFurniture?.id == furniture.id;
    
    return Positioned(
      left: furniture.position.dx,
      top: furniture.position.dy,
      child: GestureDetector(
        onTap: () => _selectFurniture(furniture),
        onPanUpdate: (details) => _moveFurniture(furniture, details),
        child: Transform.rotate(
          angle: furniture.rotation,
          child: Transform.scale(
            scale: furniture.scale,
            child: Container(
              width: 80,
              height: 60,
              decoration: BoxDecoration(
                color: isSelected ? Colors.blue.withOpacity(0.3) : Colors.transparent,
                border: Border.all(
                  color: isSelected ? Colors.blue : Colors.transparent,
                  width: 2,
                ),
                borderRadius: BorderRadius.circular(8),
              ),
              child: Stack(
                children: [
                  // Furniture image
                  ClipRRect(
                    borderRadius: BorderRadius.circular(8),
                    child: Image.asset(
                      furniture.item.image,
                      width: 80,
                      height: 60,
                      fit: BoxFit.cover,
                      errorBuilder: (context, error, stackTrace) => Container(
                        color: Colors.grey.shade200,
                        child: Icon(Icons.chair, color: Colors.grey.shade400),
                      ),
                    ),
                  ),
                  
                  // Task 2.6: Selection indicator
                  if (isSelected) _buildSelectionControls(furniture),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  // Task 2.2: Build dragging furniture preview
  Widget _buildDraggingFurniture() {
    if (_draggingFurniture == null || _dragPosition == null) return const SizedBox.shrink();
    
    return Positioned(
      left: _dragPosition!.dx - 40,
      top: _dragPosition!.dy - 30,
      child: Container(
        width: 80,
        height: 60,
        decoration: BoxDecoration(
          color: Colors.blue.withOpacity(0.3),
          border: Border.all(color: Colors.blue, width: 2),
          borderRadius: BorderRadius.circular(8),
        ),
        child: ClipRRect(
          borderRadius: BorderRadius.circular(8),
          child: Image.asset(
            _draggingFurniture!.image,
            fit: BoxFit.cover,
            errorBuilder: (context, error, stackTrace) => Container(
              color: Colors.grey.shade200,
              child: Icon(Icons.chair, color: Colors.grey.shade400),
            ),
          ),
        ),
      ),
    );
  }

  // Task 2.6: Furniture selection
  void _selectFurniture(_PlacedFurniture furniture) {
    setState(() {
      _selectedFurniture = furniture;
    });
  }

  // Task 2.2: Move furniture
  void _moveFurniture(_PlacedFurniture furniture, DragUpdateDetails details) {
    final newPosition = _snapToGrid(furniture.position + details.delta);
    
    setState(() {
      final index = _placedFurniture.indexWhere((f) => f.id == furniture.id);
      if (index != -1) {
        _placedFurniture[index] = furniture.copyWith(position: newPosition);
      }
    });
  }

  // Task 2.6: Build selection controls
  Widget _buildSelectionControls(_PlacedFurniture furniture) {
    return Positioned(
      right: -10,
      top: -10,
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          // Task 2.4: Rotation control
          GestureDetector(
            onTap: () => _rotateFurniture(furniture),
            child: Container(
              width: 24,
              height: 24,
              decoration: BoxDecoration(
                color: Colors.blue,
                borderRadius: BorderRadius.circular(12),
              ),
              child: const Icon(
                Icons.rotate_right,
                size: 16,
                color: Colors.white,
              ),
            ),
          ),
          const SizedBox(width: 4),
          // Task 2.5: Scale control
          GestureDetector(
            onTap: () => _scaleFurniture(furniture),
            child: Container(
              width: 24,
              height: 24,
              decoration: BoxDecoration(
                color: Colors.green,
                borderRadius: BorderRadius.circular(12),
              ),
              child: const Icon(
                Icons.zoom_in,
                size: 16,
                color: Colors.white,
              ),
            ),
          ),
          const SizedBox(width: 4),
          // Task 2.7: Delete control
          GestureDetector(
            onTap: () => _deleteFurniture(furniture),
            child: Container(
              width: 24,
              height: 24,
              decoration: BoxDecoration(
                color: Colors.red,
                borderRadius: BorderRadius.circular(12),
              ),
              child: const Icon(
                Icons.delete,
                size: 16,
                color: Colors.white,
              ),
            ),
          ),
        ],
      ),
    );
  }

  // Task 2.4: Rotate furniture
  void _rotateFurniture(_PlacedFurniture furniture) {
    setState(() {
      final index = _placedFurniture.indexWhere((f) => f.id == furniture.id);
      if (index != -1) {
        final newRotation = furniture.rotation + (pi / 2); // 90 degrees
        _placedFurniture[index] = furniture.copyWith(rotation: newRotation);
      }
    });
  }

  // Task 2.5: Scale furniture
  void _scaleFurniture(_PlacedFurniture furniture) {
    setState(() {
      final index = _placedFurniture.indexWhere((f) => f.id == furniture.id);
      if (index != -1) {
        final newScale = furniture.scale == 1.0 ? 1.5 : furniture.scale == 1.5 ? 0.8 : 1.0;
        _placedFurniture[index] = furniture.copyWith(scale: newScale);
      }
    });
  }

  // Task 2.7: Delete furniture
  void _deleteFurniture(_PlacedFurniture furniture) {
    setState(() {
      _placedFurniture.removeWhere((f) => f.id == furniture.id);
      if (_selectedFurniture?.id == furniture.id) {
        _selectedFurniture = null;
      }
    });
    
    // Task 4.5: Record change for undo
    _recordChange('furniture_delete', furniture);
    
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Deleted ${furniture.item.name}')),
    );
  }

  // Task 4.5: Record design change for undo/redo
  void _recordChange(String type, dynamic data) {
    final change = _DesignChange(
      id: DateTime.now().millisecondsSinceEpoch.toString(),
      type: type,
      data: data,
      timestamp: DateTime.now(),
    );
    
    setState(() {
      _designChanges.add(change);
      _currentChangeIndex = _designChanges.length - 1;
    });
  }

  // Task 4.5: Undo last change
  void _undoLastChange() {
    if (_currentChangeIndex >= 0) {
      final change = _designChanges[_currentChangeIndex];
      
      switch (change.type) {
        case 'furniture_add':
          final furniture = change.data as _PlacedFurniture;
          setState(() {
            _placedFurniture.removeWhere((f) => f.id == furniture.id);
          });
          break;
        case 'furniture_delete':
          final furniture = change.data as _PlacedFurniture;
          setState(() {
            _placedFurniture.add(furniture);
          });
          break;
        case 'wall_color':
          final wallArea = change.data['wallArea'] as _WallArea;
          final oldColor = change.data['oldColor'] as Color;
          setState(() {
            final index = _wallAreas.indexWhere((w) => w.id == wallArea.id);
            if (index != -1) {
              _wallAreas[index] = wallArea.copyWith(color: oldColor);
            }
          });
          break;
      }
      
      setState(() {
        _currentChangeIndex--;
      });
      
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Undo completed')),
      );
    }
  }

  // Task 3.6: Build wall area widget with proper texture containment
  Widget _buildWallArea(_WallArea wallArea) {
    final isSelected = _selectedWallArea?.id == wallArea.id;
    
    return Positioned(
      left: wallArea.bounds.left,
      top: wallArea.bounds.top,
      child: GestureDetector(
        onTap: () {
          setState(() {
            _selectedWallArea = wallArea;
            _selectedFurniture = null;
          });
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text('Selected wall area: ${wallArea.id}')),
          );
        },
        child: Container(
          width: wallArea.bounds.width,
          height: wallArea.bounds.height,
          decoration: BoxDecoration(
            color: wallArea.color.withOpacity(0.8),
            border: Border.all(
              color: isSelected ? Colors.blue : Colors.grey.shade400,
              width: isSelected ? 3 : 1,
              style: BorderStyle.solid,
            ),
          ),
          child: Stack(
            children: [
              ClipRect(
                child: wallArea.texture != null
                    ? Image.asset(
                        wallArea.texture!.image,
                        width: wallArea.bounds.width,
                        height: wallArea.bounds.height,
                        fit: BoxFit.cover,
                        errorBuilder: (context, error, stackTrace) => Container(
                          color: wallArea.color,
                          child: Center(
                            child: Icon(
                              Icons.texture,
                              color: wallArea.color.withOpacity(0.5),
                              size: 20,
                            ),
                          ),
                        ),
                      )
                    : null,
              ),
              if (isSelected)
                Center(
                  child: Container(
                    padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                    decoration: BoxDecoration(
                      color: Colors.blue,
                      borderRadius: BorderRadius.circular(4),
                    ),
                    child: Text(
                      'SELECTED',
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 10,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ),
            ],
          ),
        ),
      ),
    );
  }

  // Task 4.2: Build before/after comparison overlay
  Widget _buildBeforeAfterOverlay() {
    return Positioned.fill(
      child: Container(
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.centerLeft,
            end: Alignment.centerRight,
            colors: [
              Colors.black.withValues(alpha: 0.3),
              Colors.transparent,
              Colors.transparent,
              Colors.black.withValues(alpha: 0.3),
            ],
            stops: const [0.0, 0.45, 0.55, 1.0],
          ),
        ),
        child: Center(
          child: Container(
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
            decoration: BoxDecoration(
              color: Colors.black.withValues(alpha: 0.7),
              borderRadius: BorderRadius.circular(20),
            ),
            child: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                const Icon(Icons.arrow_back, color: Colors.white, size: 16),
                const SizedBox(width: 8),
                Text(
                  'BEFORE',
                  style: GoogleFonts.poppins(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                    fontSize: 12,
                  ),
                ),
                const SizedBox(width: 16),
                Container(
                  width: 2,
                  height: 20,
                  color: Colors.white,
                ),
                const SizedBox(width: 16),
                Text(
                  'AFTER',
                  style: GoogleFonts.poppins(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                    fontSize: 12,
                  ),
                ),
                const SizedBox(width: 8),
                const Icon(Icons.arrow_forward, color: Colors.white, size: 16),
              ],
            ),
          ),
        ),
      ),
    );
  }

  // Task 4.3: Build 3D-like preview overlay
  Widget _build3DPreviewOverlay() {
    return Positioned.fill(
      child: Container(
        decoration: BoxDecoration(
          gradient: RadialGradient(
            center: Alignment.center,
            radius: 0.8,
            colors: [
              Colors.transparent,
              Colors.black.withValues(alpha: 0.1),
            ],
          ),
        ),
        child: Stack(
          children: [
            // Lighting effects
            Positioned(
              top: 20,
              left: 20,
              child: Container(
                width: 60,
                height: 60,
                decoration: BoxDecoration(
                  gradient: RadialGradient(
                    colors: [
                      Colors.white.withValues(alpha: 0.3),
                      Colors.transparent,
                    ],
                  ),
                ),
              ),
            ),
            // Shadow effects
            Positioned(
              bottom: 0,
              left: 0,
              right: 0,
              child: Container(
                height: 40,
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.topCenter,
                    end: Alignment.bottomCenter,
                    colors: [
                      Colors.transparent,
                      Colors.black.withValues(alpha: 0.2),
                    ],
                  ),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// Helper classes for edit screen
class _FurnitureItem {
  final String name;
  final String image;
  final String category;
  
  _FurnitureItem({
    required this.name,
    required this.image,
    required this.category,
  });
}

// Task 2.1: Placed furniture class for drag & drop
class _PlacedFurniture {
  final String id;
  final _FurnitureItem item;
  final Offset position;
  final double rotation;
  final double scale;
  
  _PlacedFurniture({
    required this.id,
    required this.item,
    required this.position,
    this.rotation = 0.0,
    this.scale = 1.0,
  });
  
  _PlacedFurniture copyWith({
    String? id,
    _FurnitureItem? item,
    Offset? position,
    double? rotation,
    double? scale,
  }) {
    return _PlacedFurniture(
      id: id ?? this.id,
      item: item ?? this.item,
      position: position ?? this.position,
      rotation: rotation ?? this.rotation,
      scale: scale ?? this.scale,
    );
  }
}

class _WallTexture {
  final String name;
  final String image;
  final String category;
  
  _WallTexture({
    required this.name,
    required this.image,
    required this.category,
  });
}

// Task 3.6: Wall area class for wall selection
class _WallArea {
  final String id;
  final Rect bounds;
  final Color color;
  final _WallTexture? texture;
  final bool isSelectable;
  
  _WallArea({
    required this.id,
    required this.bounds,
    required this.color,
    this.texture,
    this.isSelectable = false,
  });
  
  _WallArea copyWith({
    String? id,
    Rect? bounds,
    Color? color,
    _WallTexture? texture,
    bool? isSelectable,
  }) {
    return _WallArea(
      id: id ?? this.id,
      bounds: bounds ?? this.bounds,
      color: color ?? this.color,
      texture: texture ?? this.texture,
      isSelectable: isSelectable ?? this.isSelectable,
    );
  }
}

// Task 4.5: Design change class for undo/redo system
class _DesignChange {
  final String id;
  final String type; // 'furniture_add', 'furniture_move', 'furniture_delete', 'wall_color', 'wall_texture'
  final dynamic data;
  final DateTime timestamp;
  
  _DesignChange({
    required this.id,
    required this.type,
    required this.data,
    required this.timestamp,
  });
}

// Custom painter for grid overlay
class _GridPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.grey.shade300
      ..strokeWidth = 0.5;

    // Draw vertical lines
    for (double x = 0; x <= size.width; x += 20) {
      canvas.drawLine(Offset(x, 0), Offset(x, size.height), paint);
    }

    // Draw horizontal lines
    for (double y = 0; y <= size.height; y += 20) {
      canvas.drawLine(Offset(0, y), Offset(size.width, y), paint);
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

