class _OrderManagementScreen extends StatefulWidget {
  const _OrderManagementScreen();
  @override
  State<_OrderManagementScreen> createState() => _OrderManagementScreenState();
}

class _OrderManagementScreenState extends State<_OrderManagementScreen> {
  List<_SupplierOrder> _orders = [
    _SupplierOrder(
      id: '2024-0012',
      items: '3x Oak Wood Flooring',
      total: 135,
      status: 'Shipped',
      date: '2024-06-01',
    ),
    _SupplierOrder(
      id: '2024-0011',
      items: '1x Modern Sofa',
      total: 1200,
      status: 'Pending',
      date: '2024-05-30',
    ),
    _SupplierOrder(
      id: '2024-0010',
      items: '2x Pastel Green Wall Paint',
      total: 240,
      status: 'Delivered',
      date: '2024-05-28',
    ),
  ];

  void _updateStatus(_SupplierOrder order) async {
    String? newStatus = order.status;
    final statuses = ['Pending', 'Shipped', 'Delivered', 'Cancelled'];
    final confirm = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Update Order Status'),
        content: DropdownButtonFormField<String>(
          value: newStatus,
          items: statuses.map((s) => DropdownMenuItem(value: s, child: Text(s))).toList(),
          onChanged: (v) => newStatus = v,
          decoration: const InputDecoration(labelText: 'Status'),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx, false),
            child: const Text('Cancel'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(ctx, true),
            child: const Text('Update'),
          ),
        ],
      ),
    );
    if (confirm == true && newStatus != null && newStatus != order.status) {
      setState(() {
        final idx = _orders.indexOf(order);
        _orders[idx] = _SupplierOrder(
          id: order.id,
          items: order.items,
          total: order.total,
          status: newStatus!,
          date: order.date,
        );
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Order status updated to "$newStatus" (mocked)')),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [
            const Color(0xFFBCAAA4),
            const Color(0xFFD7CCC8),
            const Color(0xFFEFEBE9),
          ],
        ),
      ),
      child: SafeArea(
        child: Column(
          children: [
            // Header
            Padding(
              padding: const EdgeInsets.all(20),
              child: Row(
                children: [

                  const SizedBox(width: 8),
                  Text(
                    'Order Management',
                    style: GoogleFonts.poppins(
                      fontSize: 20,
                      fontWeight: FontWeight.bold,
                      color: Colors.white,
                    ),
                  ),
                ],
              ),
            ),
            // Orders List
            Expanded(
              child: Container(
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: const BorderRadius.vertical(top: Radius.circular(24)),
                ),
                child: _orders.isEmpty
                    ? Center(
                        child: Column(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            Icon(Icons.inbox, size: 64, color: Colors.grey.shade400),
                            const SizedBox(height: 16),
                            Text(
                              'No orders yet',
                              style: GoogleFonts.poppins(
                                fontSize: 18,
                                color: Colors.grey.shade600,
                              ),
                            ),
                          ],
                        ),
                      )
                    : ListView.builder(
                        padding: const EdgeInsets.all(20),
                        itemCount: _orders.length,
                        itemBuilder: (context, idx) {
                          final order = _orders[idx];
                          return Container(
                            margin: const EdgeInsets.only(bottom: 16),
                            decoration: BoxDecoration(
                              color: Colors.white,
                              borderRadius: BorderRadius.circular(16),
                              boxShadow: [
                                BoxShadow(
                                  color: Colors.black.withOpacity(0.1),
                                  blurRadius: 8,
                                  offset: const Offset(0, 4),
                                ),
                              ],
                            ),
                            child: Padding(
                              padding: const EdgeInsets.all(16),
                              child: Row(
                                children: [
                                  // Order Icon
                                  Container(
                                    padding: const EdgeInsets.all(12),
                                    decoration: BoxDecoration(
                                      color: Colors.brown.shade100,
                                      borderRadius: BorderRadius.circular(12),
                                    ),
                                    child: Icon(
                                      Icons.receipt_long,
                                      color: Colors.brown.shade700,
                                      size: 24,
                                    ),
                                  ),
                                  const SizedBox(width: 16),
                                  // Order Details
                                  Expanded(
                                    child: Column(
                                      crossAxisAlignment: CrossAxisAlignment.start,
                                      children: [
                                        Text(
                                          'Order #${order.id}',
                                          style: GoogleFonts.poppins(
                                            fontWeight: FontWeight.bold,
                                            fontSize: 16,
                                            color: Colors.brown.shade900,
                                          ),
                                        ),
                                        const SizedBox(height: 4),
                                        Text(
                                          order.items,
                                          style: GoogleFonts.poppins(
                                            fontSize: 14,
                                            color: Colors.brown.shade700,
                                          ),
                                        ),
                                        const SizedBox(height: 2),
                                        Text(
                                          'Total: RM ${order.total}',
                                          style: GoogleFonts.poppins(
                                            fontSize: 14,
                                            fontWeight: FontWeight.w600,
                                            color: const Color(0xFF4CAF50),
                                          ),
                                        ),
                                        const SizedBox(height: 2),
                                        Text(
                                          'Date: ${order.date}',
                                          style: GoogleFonts.poppins(
                                            fontSize: 12,
                                            color: Colors.grey.shade600,
                                          ),
                                        ),
                                      ],
                                    ),
                                  ),
                                  // Status and Actions
                                  Column(
                                    children: [
                                      Container(
                                        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
                                        decoration: BoxDecoration(
                                          color: order.status == 'Pending' 
                                              ? Colors.orange.shade100 
                                              : order.status == 'Shipped' 
                                                  ? Colors.blue.shade100 
                                                  : order.status == 'Delivered' 
                                                      ? Colors.green.shade100 
                                                      : Colors.red.shade100,
                                          borderRadius: BorderRadius.circular(20),
                                        ),
                                        child: Text(
                                          order.status,
                                          style: GoogleFonts.poppins(
                                            fontWeight: FontWeight.w600,
                                            fontSize: 12,
                                            color: order.status == 'Pending' 
                                                ? Colors.orange.shade700 
                                                : order.status == 'Shipped' 
                                                    ? Colors.blue.shade700 
                                                    : order.status == 'Delivered' 
                                                        ? Colors.green.shade700 
                                                        : Colors.red.shade700,
                                          ),
                                        ),
                                      ),
                                      const SizedBox(height: 8),
                                      IconButton(
                                        icon: Icon(Icons.edit, size: 20),
                                        color: Colors.brown.shade600,
                                        onPressed: () => _updateStatus(order),
                                        tooltip: 'Update Status',
                                      ),
                                    ],
                                  ),
                                ],
                              ),
                            ),
                          );
                        },
                      ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

