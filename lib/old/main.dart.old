// Unified scan flow screen: scan furniture, recognize, and generate a plan view
class _ScanFlowScreen extends StatefulWidget {
  const _ScanFlowScreen();
  @override
  State<_ScanFlowScreen> createState() => _ScanFlowScreenState();
}

enum _ScanStage { init, scanning, recognizing, planView }

class _ScanFlowScreenState extends State<_ScanFlowScreen> {
  _ScanStage _stage = _ScanStage.init;
  List<String> _recognizedItems = [];
  CameraController? _cameraController;
  Future<void>? _cameraInitFuture;

  @override
  void dispose() {
    _cameraController?.dispose();
    super.dispose();
  }

  void _initCamera() {
    _initAvailableCamerasAndController(this);
  }

  void _startScan() {
    setState(() => _stage = _ScanStage.scanning);
    _initCamera();
  }

  Future<void> _performRecognition() async {
    // Move to recognizing stage immediately to show progress UI
    setState(() => _stage = _ScanStage.recognizing);

    final ctrl = _cameraController;
    if (ctrl == null || !(ctrl.value.isInitialized)) {
      setState(() {
        _recognizedItems = ['Camera not initialized'];
      });
      return;
    }

    try {
      // Capture a still image for labeling
      final xfile = await ctrl.takePicture();
      final inputImage = InputImage.fromFilePath(xfile.path);

      // Configure on-device image labeling (base model)
      final labeler = ImageLabeler(
        options: ImageLabelerOptions(confidenceThreshold: 0.6),
      );

      final labels = await labeler.processImage(inputImage);
      await labeler.close();

      // Map labels to furniture-centric names where possible
      final items = _mapLabelsToFurniture(labels);
      setState(() {
        _recognizedItems = items.isNotEmpty ? items : ['No recognizable furniture found'];
      });
    } catch (e) {
      setState(() {
        _recognizedItems = ['Recognition failed: $e'];
      });
    }
  }

  List<String> _mapLabelsToFurniture(List<ImageLabel> labels) {
    final normalized = <String>{};
    for (final l in labels) {
      final t = l.label.toLowerCase();
      if (t.contains('sofa') || t.contains('couch')) normalized.add('Sofa');
      else if (t.contains('chair') || t.contains('armchair')) normalized.add('Chair');
      else if (t.contains('table') || t.contains('desk') || t.contains('coffee')) normalized.add('Table');
      else if (t.contains('bed')) normalized.add('Bed');
      else if (t.contains('cabinet') || t.contains('dresser') || t.contains('wardrobe')) normalized.add('Cabinet');
      else if (t.contains('lamp') || t.contains('light')) normalized.add('Lamp');
      else if (t.contains('tv') || t.contains('television')) normalized.add('TV');
      else if (t.contains('plant')) normalized.add('Plant');
      else if (t.contains('carpet') || t.contains('rug')) normalized.add('Rug');
      else if (t.contains('curtain') || t.contains('blind')) normalized.add('Curtain');
      else if (t.contains('shelf') || t.contains('bookcase')) normalized.add('Shelf');
      else if (t.contains('sofa bed')) normalized.add('Sofa Bed');
      else if (t.contains('stool')) normalized.add('Stool');
      else if (t.contains('bench')) normalized.add('Bench');
      else if (t.contains('mirror')) normalized.add('Mirror');
      else if (t.contains('art') || t.contains('painting')) normalized.add('Wall Art');
      else if (t.contains('pillow') || t.contains('cushion')) normalized.add('Cushion');
      else if (t.contains('clock')) normalized.add('Clock');
      else if (t.contains('fireplace')) normalized.add('Fireplace');
      else if (t.contains('refrigerator') || t.contains('fridge')) normalized.add('Refrigerator');
      else if (t.contains('oven') || t.contains('stove')) normalized.add('Oven/Stove');
      else if (t.contains('sink')) normalized.add('Sink');
      else if (t.contains('toilet')) normalized.add('Toilet');
      else if (t.contains('bathtub')) normalized.add('Bathtub');
      else if (t.contains('shower')) normalized.add('Shower');
      else if (t.contains('washing machine') || t.contains('laundry')) normalized.add('Washing Machine');
      else if (t.contains('microwave')) normalized.add('Microwave');
      else if (t.contains('dishwasher')) normalized.add('Dishwasher');
      else if (t.contains('fan')) normalized.add('Fan');
      else if (t.contains('air conditioner') || t.contains('ac')) normalized.add('Air Conditioner');
      else if (t.contains('heater')) normalized.add('Heater');
      else if (t.contains('books')) normalized.add('Books');
      else if (t.contains('computer') || t.contains('monitor')) normalized.add('Computer');
    }
    // If nothing matched, fall back to top generic labels
    if (normalized.isEmpty && labels.isNotEmpty) {
      for (final l in labels.take(5)) {
        normalized.add(_titleCase(l.label));
      }
    }
    return normalized.toList();
  }

  String _titleCase(String s) {
    if (s.isEmpty) return s;
    return s.split(' ').map((w) => w.isEmpty ? w : (w[0].toUpperCase() + w.substring(1).toLowerCase())).join(' ');
  }

  void _restart() {
    setState(() {
      _stage = _ScanStage.init;
      _recognizedItems = [];
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Container(
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [
              const Color(0xFFBCAAA4),
              const Color(0xFFD7CCC8),
              const Color(0xFFEFEBE9),
            ],
          ),
        ),
        child: SafeArea(
          child: Padding(
            padding: const EdgeInsets.all(24.0),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                Text(
                  'Room Scan',
                  style: GoogleFonts.poppins(
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                    color: Colors.white,
                  ),
                ),
                const SizedBox(height: 16),
                Expanded(child: _buildStageView(context)),
                const SizedBox(height: 16),
                Row(
                  children: [
                    Expanded(
                      child: OutlinedButton.icon(
                        icon: const Icon(Icons.restart_alt),
                        label: Text('Restart', style: GoogleFonts.poppins(fontWeight: FontWeight.w600)),
                        style: OutlinedButton.styleFrom(
                          foregroundColor: Colors.white,
                          side: const BorderSide(color: Colors.white, width: 2),
                          padding: const EdgeInsets.symmetric(vertical: 14),
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                        ),
                        onPressed: _restart,
                      ),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: ElevatedButton.icon(
                        icon: Icon(_stage == _ScanStage.init
                            ? Icons.camera_alt
                            : _stage == _ScanStage.scanning
                                ? Icons.search
                                : _stage == _ScanStage.recognizing
                                    ? Icons.auto_awesome_motion
                                    : Icons.map),
                        label: Text(
                          _stage == _ScanStage.init
                              ? 'Start Scan'
                              : _stage == _ScanStage.scanning
                                  ? 'Recognize'
                                  : _stage == _ScanStage.recognizing
                                      ? 'Generate Plan'
                                      : 'Done',
                          style: GoogleFonts.poppins(fontWeight: FontWeight.w600),
                        ),
                        style: ElevatedButton.styleFrom(
                          backgroundColor: Colors.white,
                          foregroundColor: const Color(0xFFBCAAA4),
                          padding: const EdgeInsets.symmetric(vertical: 14),
                          shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                          elevation: 4,
                        ),
                        onPressed: () {
                          switch (_stage) {
                            case _ScanStage.init:
                              _startScan();
                              break;
                            case _ScanStage.scanning:
                              _performRecognition();
                              break;
                            case _ScanStage.recognizing:
                              setState(() => _stage = _ScanStage.planView);
                              break;
                            case _ScanStage.planView:
                              Navigator.pop(context);
                              break;
                          }
                        },
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildStageView(BuildContext context) {
    switch (_stage) {
      case _ScanStage.init:
        return _buildInitView(context);
      case _ScanStage.scanning:
        return _buildScanningView(context);
      case _ScanStage.recognizing:
        return _buildRecognizingView(context);
      case _ScanStage.planView:
        return _buildPlanView(context);
    }
  }

  Widget _buildInitView(BuildContext context) {
    return Column(
      mainAxisAlignment: MainAxisAlignment.center,
      children: [
        Container(
          width: 200,
          height: 200,
          decoration: BoxDecoration(
            color: Colors.white.withOpacity(0.2),
            shape: BoxShape.circle,
            boxShadow: [
              BoxShadow(color: Colors.black.withOpacity(0.2), blurRadius: 20, offset: const Offset(0, 10)),
            ],
          ),
          child: const Icon(Icons.camera_alt, size: 80, color: Colors.white),
        ),
        const SizedBox(height: 24),
        Text(
          'Scan furniture and generate your room plan',
          textAlign: TextAlign.center,
          style: GoogleFonts.poppins(fontSize: 16, color: Colors.white.withOpacity(0.9)),
        ),
      ],
    );
  }

  Widget _buildScanningView(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        Expanded(
          child: Container(
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(24),
              boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.2), blurRadius: 20, offset: const Offset(0, 10))],
            ),
            child: ClipRRect(
              borderRadius: BorderRadius.circular(24),
              child: Stack(
                fit: StackFit.expand,
                children: [
                  FutureBuilder<void>(
                    future: _cameraInitFuture,
                    builder: (context, snapshot) {
                      if (snapshot.connectionState == ConnectionState.done && _cameraController != null) {
                        return CameraPreview(_cameraController!);
                      }
                      // Fallback to static image while initializing or if camera unavailable
                      return Image.asset('assets/images/ar_room_scan.jpg', fit: BoxFit.cover);
                    },
                  ),
                  Center(
                    child: Container(
                      width: 220,
                      height: 220,
                      decoration: BoxDecoration(
                        border: Border.all(color: Colors.white, width: 3),
                        borderRadius: BorderRadius.circular(16),
                      ),
                    ),
                  ),
                  Align(
                    alignment: Alignment.bottomCenter,
                    child: Padding(
                      padding: const EdgeInsets.all(16.0),
                      child: LinearProgressIndicator(
                        valueColor: AlwaysStoppedAnimation<Color>(Colors.brown.shade400),
                        backgroundColor: Colors.white.withOpacity(0.6),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
        const SizedBox(height: 12),
        Text('Scanning... move your phone to capture the room',
            style: GoogleFonts.poppins(color: Colors.white)),
      ],
    );
  }

  Widget _buildRecognizingView(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(24),
        boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.2), blurRadius: 20, offset: const Offset(0, 10))],
      ),
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text('Recognized Furniture', style: GoogleFonts.poppins(fontSize: 18, fontWeight: FontWeight.w600)),
          const SizedBox(height: 12),
          Expanded(
            child: ListView.separated(
              itemCount: _recognizedItems.length,
              separatorBuilder: (_, __) => const Divider(),
              itemBuilder: (context, i) {
                final item = _recognizedItems[i];
                return ListTile(
                  leading: const Icon(Icons.chair_alt),
                  title: Text(item, style: GoogleFonts.poppins(fontWeight: FontWeight.w500)),
                  subtitle: Text('Detected via on-device recognition', style: GoogleFonts.poppins(fontSize: 12)),
                  trailing: const Icon(Icons.check_circle, color: Color(0xFF4CAF50)),
                );
              },
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildPlanView(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(24),
        boxShadow: [BoxShadow(color: Colors.black.withOpacity(0.2), blurRadius: 20, offset: const Offset(0, 10))],
      ),
      padding: const EdgeInsets.all(16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text('Plan View', style: GoogleFonts.poppins(fontSize: 18, fontWeight: FontWeight.w600)),
          const SizedBox(height: 12),
          Expanded(
            child: Center(
              child: AspectRatio(
                aspectRatio: 1,
                child: CustomPaint(
                  painter: _PlanViewPainter(),
                  child: const SizedBox.expand(),
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }
}

class _PlanViewPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final roomPaint = Paint()
      ..color = const Color(0xFFEFEBE9)
      ..style = PaintingStyle.fill;
    final wallPaint = Paint()
      ..color = const Color(0xFFBCAAA4)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 4;

    // Room rectangle
    final inset = 16.0;
    final rect = Rect.fromLTWH(inset, inset, size.width - inset * 2, size.height - inset * 2);
    canvas.drawRect(rect, roomPaint);
    canvas.drawRect(rect, wallPaint);

    // Furniture (mocked positions)
    final furniturePaint = Paint()
      ..color = const Color(0xFF80CBC4)
      ..style = PaintingStyle.fill;
    final labelStyle = TextStyle(color: Colors.brown.shade700, fontSize: 12);

    Rect sofa = Rect.fromLTWH(rect.left + 24, rect.bottom - 80, 120, 40);
    Rect coffeeTable = Rect.fromLTWH(rect.center.dx - 40, rect.center.dy - 20, 80, 40);
    Rect armchair = Rect.fromLTWH(rect.right - 100, rect.top + 40, 60, 60);
    Rect tvStand = Rect.fromLTWH(rect.right - 140, rect.bottom - 70, 120, 30);

    for (final f in [sofa, coffeeTable, armchair, tvStand]) {
      canvas.drawRect(f, furniturePaint);
    }

    void label(String text, Offset at) {
      final tp = TextPainter(
        text: TextSpan(text: text, style: labelStyle),
        textDirection: TextDirection.ltr,
      )..layout(minWidth: 0, maxWidth: size.width);
      tp.paint(canvas, at);
    }

    label('Sofa', Offset(sofa.left + 8, sofa.top - 18));
    label('Coffee Table', Offset(coffeeTable.left + 8, coffeeTable.top - 18));
    label('Armchair', Offset(armchair.left + 8, armchair.top - 18));
    label('TV Stand', Offset(tvStand.left + 8, tvStand.top - 18));
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => true;
}

// Initialize the camera lazily when starting the scan
Future<void> _initAvailableCamerasAndController(_ScanFlowScreenState state) async {
  try {
    final cameras = await availableCameras();
    final back = cameras.firstWhere((c) => c.lensDirection == CameraLensDirection.back, orElse: () => cameras.first);
    final controller = CameraController(back, ResolutionPreset.medium, enableAudio: false);
    state._cameraController = controller;
    state._cameraInitFuture = controller.initialize();
  } catch (_) {
    // Fallback: proceed without camera
    state._cameraController = null;
    state._cameraInitFuture = Future.value();
  }
}


class _AIRecommendationScreen extends StatefulWidget {
  const _AIRecommendationScreen();
  @override
  State<_AIRecommendationScreen> createState() => _AIRecommendationScreenState();
}

class _AIRecommendationScreenState extends State<_AIRecommendationScreen> {
  String _conversationState = 'initial';
  String? _selectedStyle;
  String? _selectedRoomType;
  final List<_ChatMessage> _messages = [];
  final TextEditingController _controller = TextEditingController();
  late final GeminiChatService _gemini;

  @override
  void initState() {
    super.initState();
    // Initialize Gemini using centralized config values and safe defaults.
    final key = AppConfig.geminiApiKey;
    final model = AppConfig.geminiModel;
    _gemini = GeminiChatService(apiKey: key, model: model);
  }

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    // Show style selection dialog after dependencies are initialized
    if (_conversationState == 'initial') {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        _showStyleSelectionDialog();
      });
    }
  }

  void _showStyleSelectionDialog() {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) => AlertDialog(
        title: Text(
          'Choose Your Design Style',
          style: GoogleFonts.poppins(fontWeight: FontWeight.bold),
        ),
        content: SizedBox(
          width: double.maxFinite,
          height: MediaQuery.of(context).size.height * 0.6,
          child: Column(
            children: [
              Text(
                'What style are you looking for?',
                style: GoogleFonts.poppins(fontSize: 16),
              ),
              const SizedBox(height: 20),
              Expanded(
                child: SingleChildScrollView(
                  child: Column(
                    children: [
                      _StyleOptionCard(
                        title: 'Modern',
                        description: 'Clean lines, minimal decor',
                        icon: Icons.home_work,
                        onTap: () => _selectStyle('Modern'),
                      ),
                      const SizedBox(height: 12),
                      _StyleOptionCard(
                        title: 'Classic',
                        description: 'Timeless elegance',
                        icon: Icons.king_bed,
                        onTap: () => _selectStyle('Classic'),
                      ),
                      const SizedBox(height: 12),
                      _StyleOptionCard(
                        title: 'Minimalist',
                        description: 'Simple and functional',
                        icon: Icons.design_services,
                        onTap: () => _selectStyle('Minimalist'),
                      ),
                      const SizedBox(height: 12),
                      _StyleOptionCard(
                        title: 'Bohemian',
                        description: 'Eclectic and artistic',
                        icon: Icons.brush,
                        onTap: () => _selectStyle('Bohemian'),
                      ),
                      const SizedBox(height: 12),
                      _StyleOptionCard(
                        title: 'Scandinavian',
                        description: 'Light and airy',
                        icon: Icons.wb_sunny,
                        onTap: () => _selectStyle('Scandinavian'),
                      ),
                      const SizedBox(height: 12),
                      _StyleOptionCard(
                        title: 'Industrial',
                        description: 'Raw and urban',
                        icon: Icons.construction,
                        onTap: () => _selectStyle('Industrial'),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  void _selectStyle(String style) {
    setState(() {
      _selectedStyle = style;
      _conversationState = 'askingRoom';
      _messages.add(_ChatMessage(sender: 'AI', text: 'Great! You chose $style style. Now, which room are you designing?'));
    });
    Navigator.pop(context);
    _showRoomSelectionDialog();
  }

  void _showRoomSelectionDialog() {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (context) => AlertDialog(
        title: Text(
          'Choose Your Room',
          style: GoogleFonts.poppins(fontWeight: FontWeight.bold),
        ),
        content: SizedBox(
          width: double.maxFinite,
          height: MediaQuery.of(context).size.height * 0.6,
          child: Column(
            children: [
              Text(
                'Which room are you designing?',
                style: GoogleFonts.poppins(fontSize: 16),
              ),
              const SizedBox(height: 12),
              Expanded(
                child: SingleChildScrollView(
                  child: Column(
                    children: [
                      _RoomOptionCard(
                        title: 'Living Room',
                        description: 'Main gathering space',
                        icon: Icons.weekend,
                        onTap: () => _selectRoom('Living Room'),
                      ),
                      const SizedBox(height: 12),
                      _RoomOptionCard(
                        title: 'Bedroom',
                        description: 'Personal sanctuary',
                        icon: Icons.bed,
                        onTap: () => _selectRoom('Bedroom'),
                      ),
                      const SizedBox(height: 12),
                      _RoomOptionCard(
                        title: 'Kitchen',
                        description: 'Cooking and dining',
                        icon: Icons.kitchen,
                        onTap: () => _selectRoom('Kitchen'),
                      ),
                      const SizedBox(height: 12),
                      _RoomOptionCard(
                        title: 'Bathroom',
                        description: 'Relaxation space',
                        icon: Icons.bathtub,
                        onTap: () => _selectRoom('Bathroom'),
                      ),
                      const SizedBox(height: 12),
                      _RoomOptionCard(
                        title: 'Dining Room',
                        description: 'Formal dining area',
                        icon: Icons.restaurant,
                        onTap: () => _selectRoom('Dining Room'),
                      ),
                      const SizedBox(height: 12),
                      _RoomOptionCard(
                        title: 'Home Office',
                        description: 'Work and productivity',
                        icon: Icons.work,
                        onTap: () => _selectRoom('Home Office'),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  void _selectRoom(String room) {
    setState(() {
      _selectedRoomType = room;
      _conversationState = 'showingRecommendations';
      _messages.add(_ChatMessage(sender: 'You', text: room));
      _messages.add(_ChatMessage(sender: 'AI', text: 'Perfect! For a $_selectedStyle $_selectedRoomType, here are my recommendations:'));
    });
    Navigator.pop(context);
  }

  void _sendMessage() async {
    final text = _controller.text.trim();
    if (text.isEmpty) return;
    setState(() {
      _messages.add(_ChatMessage(sender: 'You', text: text));
      _messages.add(_ChatMessage(sender: 'AI', text: '...'));
      _controller.clear();
    });

    final prompt = _buildPrompt(text);
    try {
      final reply = await _gemini.sendMessage(prompt);
      setState(() {
        _messages[_messages.length - 1] = _ChatMessage(sender: 'AI', text: reply);
      });
    } catch (e) {
      setState(() {
        _messages[_messages.length - 1] = _ChatMessage(sender: 'AI', text: 'Error contacting Gemini: $e');
      });
    }
  }

  String _buildPrompt(String userInput) {
    final style = _selectedStyle ?? 'any style';
    final room = _selectedRoomType ?? 'any room';
    return 'You are an interior design assistant for a home renovation app. '
        'Consider the user\'s chosen style "$style" and room "$room". '
        'Provide practical, concise recommendations on materials, placement, layout, and shopping ideas. '
        'If relevant, suggest AR visualization steps. '
        'User question: $userInput';
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Expanded(
          child: ListView.builder(
            padding: const EdgeInsets.all(16),
            itemCount: _messages.length,
            itemBuilder: (context, idx) {
              final msg = _messages[idx];
              final isAI = msg.sender == 'AI';
              return Align(
                alignment: isAI ? Alignment.centerLeft : Alignment.centerRight,
                child: Container(
                  margin: const EdgeInsets.symmetric(vertical: 4),
                  padding: const EdgeInsets.symmetric(vertical: 10, horizontal: 14),
                  decoration: BoxDecoration(
                    color: isAI ? Colors.brown.shade50 : Colors.brown.shade100,
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Text(msg.text, style: TextStyle(color: isAI ? Colors.brown.shade700 : Colors.brown.shade900)),
                ),
              );
            },
          ),
        ),
        if (_conversationState == 'showingRecommendations')
          Container(
            color: Colors.brown.shade50,
            padding: const EdgeInsets.symmetric(vertical: 12, horizontal: 16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  'Recommended for your $_selectedStyle $_selectedRoomType:',
                  style: GoogleFonts.poppins(fontWeight: FontWeight.bold),
                ),
                const SizedBox(height: 8),
                _StyleRecommendationTile(
                  title: 'Modern Sofa',
                  subtitle: 'Perfect for your living room',
                  image: 'assets/images/sofa_modern.jpg',
                ),
                _StyleRecommendationTile(
                  title: 'Oak Wood Flooring',
                  subtitle: 'Durable and stylish option',
                  image: 'assets/images/flooring.jpg',
                ),
                _StyleRecommendationTile(
                  title: 'Minimalist Wall Art',
                  subtitle: 'Adds a touch of elegance',
                  image: 'assets/images/wall_art.jpg',
                ),
              ],
            ),
          ),
        Padding(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
          child: Row(
            children: [
              Expanded(
                child: TextField(
                  controller: _controller,
                  decoration: InputDecoration(
                    hintText: 'Type your message...',
                    border: OutlineInputBorder(borderRadius: BorderRadius.circular(25)),
                    contentPadding: const EdgeInsets.symmetric(horizontal: 20, vertical: 10),
                  ),
                  onSubmitted: (_) => _sendMessage(),
                ),
              ),
              const SizedBox(width: 8),
              IconButton(
                icon: const Icon(Icons.send),
                color: Colors.brown.shade700,
                onPressed: _sendMessage,
              ),
            ],
          ),
        ),
      ],
    );
  }
}

class _ChatMessage {
  final String sender;
  final String text;
  _ChatMessage({required this.sender, required this.text});
}

class _StyleOptionCard extends StatelessWidget {
  final String title;
  final String description;
  final IconData icon;
  final VoidCallback onTap;
  
  const _StyleOptionCard({
    required this.title,
    required this.description,
    required this.icon,
    required this.onTap,
    Key? key,
  }) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        padding: const EdgeInsets.all(17),
        decoration: BoxDecoration(
          color: Colors.brown.shade50,
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: Colors.brown.shade200),
        ),
        child: Row(
          children: [
            Icon(icon, color: Colors.brown.shade700, size: 24),
            const SizedBox(width: 12),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    title,
                    style: GoogleFonts.poppins(
                      fontWeight: FontWeight.bold,
                      fontSize: 16,
                      color: Colors.brown.shade900,
                    ),
                  ),
                  const SizedBox(height: 2),
                  Text(
                    description,
                    style: GoogleFonts.poppins(
                      fontSize: 12,
                      color: Colors.brown.shade700,
                    ),
                  ),
                ],
              ),
            ),
            Icon(Icons.arrow_forward_ios, color: Colors.brown.shade400, size: 16),
          ],
        ),
      ),
    );
  }
}

class _RoomOptionCard extends StatelessWidget {
  final String title;
  final String description;
  final IconData icon;
  final VoidCallback onTap;
  
  const _RoomOptionCard({
