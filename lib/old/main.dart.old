              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    title,
                    style: GoogleFonts.poppins(
                      fontWeight: FontWeight.bold,
                      fontSize: 16,
                      color: Colors.brown.shade900,
                    ),
                  ),
                  const SizedBox(height: 2),
                  Text(
                    description,
                    style: GoogleFonts.poppins(
                      fontSize: 12,
                      color: Colors.brown.shade700,
                    ),
                  ),
                ],
              ),
            ),
            Icon(Icons.arrow_forward_ios, color: Colors.brown.shade400, size: 16),
          ],
        ),
      ),
    );
  }
}


class _StyleRecommendationTile extends StatelessWidget {
  final String title;
  final String subtitle;
  final String image;
  
  const _StyleRecommendationTile({
    required this.title,
    required this.subtitle,
    required this.image,
    Key? key,
  }) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return Container(
      margin: const EdgeInsets.only(bottom: 12),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(0.1),
            blurRadius: 4,
            offset: const Offset(0, 2),
          ),
        ],
      ),
      child: ListTile(
        leading: Container(
          width: 50,
          height: 50,
          decoration: BoxDecoration(
            borderRadius: BorderRadius.circular(8),
          ),
          child: ClipRRect(
            borderRadius: BorderRadius.circular(8),
            child: Image.asset(
              image,
              fit: BoxFit.cover,
              errorBuilder: (context, error, stackTrace) => Container(
                color: Colors.grey.shade200,
                child: Icon(Icons.image, size: 24, color: Colors.grey.shade400),
              ),
            ),
          ),
        ),
        title: Text(
          title,
          style: GoogleFonts.poppins(fontWeight: FontWeight.w600),
        ),
        subtitle: Text(subtitle),
        trailing: IconButton(
          icon: const Icon(Icons.add_shopping_cart),
          color: const Color(0xFF80CBC4),
          onPressed: () {
            _showSuccessDialog(context, title);
          },
        ),
      ),
    );
  }

  void _showSuccessDialog(BuildContext context, String title) {
    showDialog(
      context: context,
      builder: (BuildContext context) {
        return AlertDialog(
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(16),
          ),
          title: Row(
            children: [
              Icon(Icons.check_circle, color: Colors.green, size: 24),
              const SizedBox(width: 8),
              Text('Added to Cart', style: GoogleFonts.poppins(fontWeight: FontWeight.bold)),
            ],
          ),
          content: Text('$title has been added to your cart!'),
          actions: [
            TextButton(
              onPressed: () => Navigator.of(context).pop(),
              child: Text('OK', style: GoogleFonts.poppins()),
            ),
          ],
        );
      },
    );
  }
}

class _MarketplaceScreen extends StatefulWidget {
  const _MarketplaceScreen();
  @override
  State<_MarketplaceScreen> createState() => _MarketplaceScreenState();
}

class _MarketplaceScreenState extends State<_MarketplaceScreen> {
  String _selectedFilter = 'All';
  
  final List<Product> _cart = [];

  int _crossAxisCountForWidth(double width) {
    if (width < 480) return 1; // very small phones
    if (width < 768) return 2; // phones
    if (width < 1024) return 3; // tablets / small desktop
    if (width < 1440) return 4; // desktop
    return 5; // large desktop
  }

  double _childAspectRatioForWidth(double width) {
    if (width < 480) return 0.85;
    if (width < 768) return 0.75;
    if (width < 1024) return 0.7;
    if (width < 1440) return 0.68;
    return 0.65;
  }

  void _showProductDetail(Product product) {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(22)),
      ),
      builder: (ctx) => Padding(
        padding: const EdgeInsets.all(22.0),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // Product Image and Basic Info
            Row(
              children: [
                Container(
                  width: 80,
                  height: 80,
                  decoration: BoxDecoration(
                    color: Colors.brown.shade50,
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Image.asset(
                    product.image,
                    fit: BoxFit.contain,
                    errorBuilder: (context, error, stackTrace) => Icon(Icons.image, size: 40, color: Colors.brown.shade200),
                  ),
                ),
                const SizedBox(width: 16),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(product.name, style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 18)),
                      const SizedBox(height: 4),
                      Text('RM ${product.price}', style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 16, color: const Color(0xFF4CAF50))),
                      const SizedBox(height: 4),
                      Text('Stock: ${product.stock > 0 ? "${product.stock} left" : "Out of stock"}', 
                           style: GoogleFonts.poppins(fontSize: 12, color: product.stock > 0 ? Colors.green.shade600 : Colors.red.shade600)),
                    ],
                  ),
                ),
              ],
            ),
            const SizedBox(height: 20),
            
            // Product Description
            Text('Description', style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 16)),
            const SizedBox(height: 8),
            Text(product.description, style: GoogleFonts.poppins(fontSize: 14)),
            const SizedBox(height: 16),
            
            // Supplier Details Section
            Container(
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: Colors.brown.shade50,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: Colors.brown.shade200),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      Icon(Icons.business, size: 20, color: Colors.brown.shade700),
                      const SizedBox(width: 8),
                      Text('Supplier Details', style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 14)),
                    ],
                  ),
                  const SizedBox(height: 8),
                  Text(product.supplier.name, style: GoogleFonts.poppins(fontWeight: FontWeight.w600, fontSize: 14)),
                  const SizedBox(height: 4),
                  Row(
                    children: [
                      Icon(Icons.phone, size: 14, color: Colors.brown.shade600),
                      const SizedBox(width: 4),
                      Text(product.supplier.phone, style: GoogleFonts.poppins(fontSize: 12)),
                    ],
                  ),
                  const SizedBox(height: 2),
                  Row(
                    children: [
                      Icon(Icons.email, size: 14, color: Colors.brown.shade600),
                      const SizedBox(width: 4),
                      Expanded(child: Text(product.supplier.email, style: GoogleFonts.poppins(fontSize: 12))),
                    ],
                  ),
                ],
              ),
            ),
            const SizedBox(height: 20),
            
            // Action Buttons
            Row(
              children: [
                Expanded(
                  child: ElevatedButton.icon(
                    icon: const Icon(Icons.add_shopping_cart),
                    label: const Text('Add to Cart'),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: Colors.brown.shade100,
                      foregroundColor: Colors.brown.shade700,
                      padding: const EdgeInsets.symmetric(vertical: 12),
                    ),
                    onPressed: product.stock > 0
                        ? () {
                            Navigator.pop(ctx);
                            setState(() => _cart.add(product));
                            ScaffoldMessenger.of(context).showSnackBar(
                              SnackBar(content: Text('Added "${product.name}" to cart')),
                            );
                          }
                        : null,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: OutlinedButton.icon(
                    icon: const Icon(Icons.business),
                    label: const Text('Contact Supplier'),
                    style: OutlinedButton.styleFrom(
                      foregroundColor: Colors.brown.shade700,
                      side: BorderSide(color: Colors.brown.shade300),
                      padding: const EdgeInsets.symmetric(vertical: 12),
                    ),
                    onPressed: () {
                      Navigator.pop(ctx);
                      _showSupplierDetails(context, product.supplier);
                    },
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            SizedBox(
              width: double.infinity,
              child: OutlinedButton.icon(
                icon: const Icon(Icons.close),
                label: const Text('Close'),
                style: OutlinedButton.styleFrom(
                  foregroundColor: Colors.grey.shade600,
                  side: BorderSide(color: Colors.grey.shade300),
                  padding: const EdgeInsets.symmetric(vertical: 12),
                ),
                onPressed: () => Navigator.pop(ctx),
              ),
            ),
          ],
        ),
      ),
    );
  }

  void _showSupplierDetails(BuildContext context, Supplier supplier) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Row(
          children: [
            Icon(Icons.business, color: Colors.brown.shade700),
            const SizedBox(width: 8),
            Text('Supplier Details', style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 16)),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              supplier.name,
              style: GoogleFonts.poppins(fontWeight: FontWeight.w600, fontSize: 16),
            ),
            const SizedBox(height: 12),
            _buildDetailRow(Icons.phone, 'Phone', supplier.phone),
            const SizedBox(height: 8),
            _buildDetailRow(Icons.email, 'Email', supplier.email),
            const SizedBox(height: 8),
            _buildDetailRow(Icons.location_on, 'Address', supplier.address),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: Text('Close', style: GoogleFonts.poppins()),
          ),
        ],
      ),
    );
  }

  Widget _buildDetailRow(IconData icon, String label, String value) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Icon(icon, size: 16, color: Colors.brown.shade600),
        const SizedBox(width: 8),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: GoogleFonts.poppins(
                  fontSize: 12,
                  fontWeight: FontWeight.w500,
                  color: Colors.brown.shade700,
                ),
              ),
              Text(
                value,
                style: GoogleFonts.poppins(fontSize: 14),
              ),
            ],
          ),
        ),
      ],
    );
  }

  void _showCart() {
    showModalBottomSheet(
      context: context,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (ctx) => Padding(
        padding: const EdgeInsets.all(24.0),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text('Your Cart', style: TextStyle(fontWeight: FontWeight.bold, fontSize: 18)),
            const SizedBox(height: 12),
            if (_cart.isEmpty)
              const Text('Your cart is empty.'),
            if (_cart.isNotEmpty)
              ..._cart.map((p) => ListTile(
                    leading: Image.asset(
                      p.image,
                      width: 36,
                      height: 36,
                      fit: BoxFit.contain,
                      errorBuilder: (context, error, stackTrace) => Icon(Icons.image, size: 24, color: Colors.brown.shade200),
                    ),
                    title: Text(p.name),
                    subtitle: Text('RM ${p.price}'),
                  )),
            const SizedBox(height: 16),
            if (_cart.isNotEmpty)
              ElevatedButton.icon(
                icon: const Icon(Icons.payment),
                label: const Text('Checkout'),
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.brown.shade100,
                  foregroundColor: Colors.brown.shade700,
                ),
                onPressed: () {
                  Navigator.pop(ctx);
                  setState(() => _cart.clear());
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('Checkout complete (mocked)')),
                  );
                },
              ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final marketplace = Provider.of<MarketplaceProvider>(context);
    return Container(
      decoration: BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topCenter,
          end: Alignment.bottomCenter,
          colors: [
            const Color(0xFFBCAAA4),
            const Color(0xFFD7CCC8),
            const Color(0xFFEFEBE9),
          ],
        ),
      ),
      child: SafeArea(
        child: Column(
          children: [
            // Header
            Padding(
              padding: const EdgeInsets.all(20),
              child: Column(
                children: [
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Text(
                        'Marketplace',
                        style: GoogleFonts.poppins(
                          fontSize: 24,
                          fontWeight: FontWeight.bold,
                          color: Colors.white,
                        ),
                      ),
                      Stack(
                        children: [
                          Container(
                            padding: const EdgeInsets.all(8),
                            decoration: BoxDecoration(
                              color: Colors.white.withOpacity(0.2),
                              borderRadius: BorderRadius.circular(12),
                            ),
                            child: IconButton(
                              icon: const Icon(Icons.shopping_cart, color: Colors.white),
                              onPressed: _showCart,
                            ),
                          ),
                          if (_cart.isNotEmpty)
                            Positioned(
                              right: 4,
                              top: 4,
                              child: Container(
                                padding: const EdgeInsets.all(4),
                                decoration: BoxDecoration(
                                  color: const Color(0xFFFF5722),
                                  borderRadius: BorderRadius.circular(10),
                                ),
                                constraints: const BoxConstraints(minWidth: 20, minHeight: 20),
                                child: Text(
                                  '${_cart.length}',
                                  style: GoogleFonts.poppins(
                                    color: Colors.white,
                                    fontSize: 12,
                                    fontWeight: FontWeight.bold,
                                  ),
                                  textAlign: TextAlign.center,
                                ),
                              ),
                            ),
                        ],
                      ),
                    ],
                  ),
                  const SizedBox(height: 16),
                  // Filter Section
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                    decoration: BoxDecoration(
                      color: Colors.white.withOpacity(0.2),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: Row(
                      children: [
                        Icon(Icons.filter_list, color: Colors.white, size: 20),
                        const SizedBox(width: 8),
                        Text(
                          'Style:',
                          style: GoogleFonts.poppins(
                            fontSize: 14,
                            fontWeight: FontWeight.w600,
                            color: Colors.white,
                          ),
                        ),
                        const SizedBox(width: 8),
                        Expanded(
                          child: Material(
                            color: Colors.transparent,
                            child: DropdownButton<String>(
                              value: _selectedFilter,
                              isExpanded: true,
                              underline: Container(),
                              dropdownColor: Colors.brown.shade800,
                              style: GoogleFonts.poppins(
                                fontSize: 14,
                                color: Colors.white,
                              ),
                              items: ['All', 'Modern', 'Classic', 'Industrial', 'Scandinavian', 'Bohemian'].map((style) {
                                return DropdownMenuItem(
                                  value: style,
                                  child: Text(
                                    style,
                                    style: GoogleFonts.poppins(
                                      fontSize: 14,
                                      color: Colors.white,
                                    ),
                                  ),
                                );
                              }).toList(),
                              onChanged: (value) {
                                setState(() {
                                  _selectedFilter = value!;
                                });
                              },
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
            // Products Grid (responsive)
            Expanded(
              child: Container(
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: const BorderRadius.vertical(top: Radius.circular(24)),
                ),
                child: LayoutBuilder(
                  builder: (context, constraints) {
                    final width = constraints.maxWidth;
                    final crossAxisCount = _crossAxisCountForWidth(width);
                    final aspectRatio = _childAspectRatioForWidth(width);
                    if (marketplace.status == MarketplaceStatus.loading) {
                      return Center(child: CircularProgressIndicator());
                    }
                    if (marketplace.status == MarketplaceStatus.error) {
                      return Center(
                        child: Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Text('Failed to load products', style: GoogleFonts.poppins(fontWeight: FontWeight.w600)),
                            const SizedBox(height: 8),
                            OutlinedButton(
                              onPressed: () => marketplace.fetchProducts(),
                              child: const Text('Retry'),
                            ),
                          ],
                        ),
                      );
                    }
                    final products = marketplace.filteredByStyle(_selectedFilter);
                    return GridView.builder(
                      padding: const EdgeInsets.all(20),
                      gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                        crossAxisCount: crossAxisCount,
                        childAspectRatio: aspectRatio,
                        crossAxisSpacing: 12,
                        mainAxisSpacing: 12,
                      ),
                      itemCount: products.length,
                      itemBuilder: (context, idx) {
                        final product = products[idx];
                        return ProductCard(
                          product: product,
                          onTap: () => _showProductDetail(product),
                        );
                      },
                    );
                  },
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class ProductCard extends StatelessWidget {
  final Product product;
  final VoidCallback onTap;

  const ProductCard({
    required this.product,
    required this.onTap,
    Key? key,
  }) : super(key: key);

  void _showSupplierDetails(BuildContext context, Supplier supplier) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Row(
          children: [
            Icon(Icons.business, color: Colors.brown.shade700),
            const SizedBox(width: 8),
            Text('Supplier Details', style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 16)),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              supplier.name,
              style: GoogleFonts.poppins(fontWeight: FontWeight.w600, fontSize: 16),
            ),
            const SizedBox(height: 12),
            _buildDetailRow(Icons.phone, 'Phone', supplier.phone),
            const SizedBox(height: 8),
            _buildDetailRow(Icons.email, 'Email', supplier.email),
            const SizedBox(height: 8),
            _buildDetailRow(Icons.location_on, 'Address', supplier.address),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: Text('Close', style: GoogleFonts.poppins()),
          ),
        ],
      ),
    );
  }

  Widget _buildDetailRow(IconData icon, String label, String value) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Icon(icon, size: 16, color: Colors.brown.shade600),
        const SizedBox(width: 8),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                label,
                style: GoogleFonts.poppins(
                  fontSize: 12,
                  fontWeight: FontWeight.w500,
                  color: Colors.brown.shade700,
                ),
              ),
              Text(
                value,
                style: GoogleFonts.poppins(fontSize: 14),
              ),
            ],
          ),
        ),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: LayoutBuilder(
        builder: (context, constraints) {
          final cardWidth = constraints.maxWidth;
          final isCompact = cardWidth < 220;
          final titleSize = isCompact ? 12.0 : 14.0;
          final priceSize = isCompact ? 13.0 : 16.0;
          final metaSize = isCompact ? 11.0 : 12.0;
          final supplierIconSize = isCompact ? 12.0 : 14.0;
          final supplierTextSize = isCompact ? 10.0 : 12.0;
          final contentHPad = isCompact ? 8.0 : 12.0;
          final contentVPad = isCompact ? 8.0 : 10.0;

          return Container(
            decoration: BoxDecoration(
              color: Colors.white,
              borderRadius: BorderRadius.circular(16),
              boxShadow: [
                BoxShadow(
                  color: Colors.black.withOpacity(0.1),
                  blurRadius: 8,
                  offset: const Offset(0, 4),
                ),
              ],
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Expanded(
                  flex: 3,
                  child: Container(
                    width: double.infinity,
                    decoration: const BoxDecoration(
                      borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
                    ),
                    child: ClipRRect(
                      borderRadius: const BorderRadius.vertical(top: Radius.circular(16)),
                      child: Image.asset(
                        product.image,
                        fit: BoxFit.cover,
                        errorBuilder: (context, error, stackTrace) => Container(
                          color: Colors.grey.shade200,
                          child: Icon(Icons.image, size: 32, color: Colors.grey.shade400),
                        ),
                      ),
                    ),
                  ),
                ),
                Expanded(
                  flex: 2,
                  child: Padding(
                    padding: EdgeInsets.symmetric(horizontal: contentHPad, vertical: contentVPad),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisAlignment: MainAxisAlignment.start,
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
                          product.name,
                          style: GoogleFonts.poppins(
                            fontWeight: FontWeight.w600,
                            fontSize: titleSize,
                            color: Colors.brown.shade900,
                          ),
                          maxLines: 1,
                          overflow: TextOverflow.ellipsis,
                        ),
                        const SizedBox(height: 4),
                        Text(
                          'RM ${product.price}',
                          style: GoogleFonts.poppins(
                            fontWeight: FontWeight.bold,
                            fontSize: priceSize,
                            color: const Color(0xFF4CAF50),
                          ),
                        ),
                        const SizedBox(height: 6),
                        Row(
                          children: [
                            Container(
                              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 3),
                              decoration: BoxDecoration(
                                color: Colors.brown.shade100,
                                borderRadius: BorderRadius.circular(6),
                                border: Border.all(color: Colors.brown.shade300, width: 0.5),
                              ),
                              child: Text(
                                product.category,
                                style: GoogleFonts.poppins(
                                  fontSize: metaSize,
                                  color: Colors.brown.shade700,
                                  fontWeight: FontWeight.w500,
                                ),
                                maxLines: 1,
                                overflow: TextOverflow.ellipsis,
                              ),
                            ),
                            const SizedBox(width: 8),
                            Text(
                              product.stock > 0 ? '${product.stock} left' : '0 left',
                              style: GoogleFonts.poppins(
                                fontSize: metaSize,
                                color: product.stock > 0 ? Colors.green.shade600 : Colors.red.shade600,
                              ),
                            ),
                          ],
                        ),
                        const SizedBox(height: 6),
                        GestureDetector(
                          onTap: () => _showSupplierDetails(context, product.supplier),
                          child: Row(
                            children: [
                              Icon(Icons.business, size: supplierIconSize, color: Colors.brown.shade600),
                              const SizedBox(width: 6),
                              Expanded(
                                child: Text(
                                  product.supplier.name,
                                  style: GoogleFonts.poppins(
                                    fontSize: supplierTextSize,
                                    color: Colors.brown.shade600,
                                    fontWeight: FontWeight.w500,
                                  ),
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ),
          );
        },
      ),
    );
  }
}

class _BudgetPlannerScreen extends StatefulWidget {
  const _BudgetPlannerScreen();
  @override
  State<_BudgetPlannerScreen> createState() => _BudgetPlannerScreenState();
}

class _BudgetPlannerScreenState extends State<_BudgetPlannerScreen> {
  final _formKey = GlobalKey<FormState>();
  final _budgetController = TextEditingController(text: '5000');
  String _selectedRoom = 'Kitchen';
  bool _ecoFriendly = false;
  
  // Real-time cost calculation based on selections
  int get _wallPaintCost => _ecoFriendly ? 180 : 120;
  int get _flooringCost => _selectedRoom == 'Kitchen' ? 2200 : 
                          _selectedRoom == 'Living Room' ? 1800 :
                          _selectedRoom == 'Bedroom' ? 1600 : 1400;
  int get _furnitureCost => _selectedRoom == 'Kitchen' ? 800 :
                           _selectedRoom == 'Living Room' ? 1200 :
                           _selectedRoom == 'Bedroom' ? 900 : 600;
  int get _lightingCost => _selectedRoom == 'Kitchen' ? 600 :
                          _selectedRoom == 'Living Room' ? 800 :
                          _selectedRoom == 'Bedroom' ? 500 : 400;
  int get _accessoriesCost => _selectedRoom == 'Kitchen' ? 400 :
                             _selectedRoom == 'Living Room' ? 600 :
                             _selectedRoom == 'Bedroom' ? 300 : 200;
  
  int get _totalCost => _wallPaintCost + _flooringCost + _furnitureCost + _lightingCost + _accessoriesCost;

  void _exportReport() {
    // Create cost breakdown map
    Map<String, int> costBreakdown = {
      'Wall Paint': _wallPaintCost,
      'Flooring': _flooringCost,
      'Furniture': _furnitureCost,
      'Lighting': _lightingCost,
      'Accessories': _accessoriesCost,
    };
    
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => BudgetReportScreen(
          selectedRoom: _selectedRoom,
          totalBudget: int.tryParse(_budgetController.text) ?? 0,
          totalCost: _totalCost,
          costBreakdown: costBreakdown,
          ecoFriendly: _ecoFriendly,
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final int budget = int.tryParse(_budgetController.text) ?? 0;
    final bool overBudget = _totalCost > budget;
    final int remaining = budget - _totalCost;
    
    return Scaffold(
      body: Container(
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [
              const Color(0xFFBCAAA4),
              const Color(0xFFD7CCC8),
              const Color(0xFFEFEBE9),
            ],
          ),
        ),
        child: SafeArea(
          child: SingleChildScrollView(
            padding: const EdgeInsets.all(20),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                // Header
                Row(
                  children: [
                    IconButton(
                      icon: Icon(Icons.arrow_back, color: Colors.white, size: 24),
                      onPressed: () => Navigator.pop(context),
                    ),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            'Budget Planner',
                            style: GoogleFonts.poppins(
                              fontSize: 28,
                              fontWeight: FontWeight.bold,
                              color: Colors.white,
                            ),
                          ),
                          const SizedBox(height: 8),
                          Text(
                            'Plan your $_selectedRoom renovation',
                            style: GoogleFonts.poppins(
                              fontSize: 16,
                              color: Colors.white.withOpacity(0.9),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 24),
              
              // Budget Overview Card
              Container(
                padding: const EdgeInsets.all(20),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(20),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.1),
                      blurRadius: 10,
                      offset: const Offset(0, 5),
                    ),
                  ],
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      'Budget Overview',
                      style: GoogleFonts.poppins(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                        color: Colors.brown.shade900,
                      ),
                    ),
                    const SizedBox(height: 16),
                    Row(
                      children: [
                        Expanded(
                          child: _BudgetStatCard(
                            title: 'Total Budget',
                            value: 'RM $budget',
                            color: const Color(0xFF4CAF50),
                          ),
                        ),
                        const SizedBox(width: 12),
                        Expanded(
                          child: _BudgetStatCard(
                            title: 'Total Cost',
                            value: 'RM $_totalCost',
                            color: overBudget ? const Color(0xFFFF5722) : const Color(0xFF2196F3),
                          ),
                        ),
                        const SizedBox(width: 12),
                        Expanded(
                          child: _BudgetStatCard(
                            title: overBudget ? 'Over Budget' : 'Remaining',
                            value: overBudget ? 'RM ${_totalCost - budget}' : 'RM $remaining',
                            color: overBudget ? const Color(0xFFFF5722) : const Color(0xFF4CAF50),
                          ),
                        ),
                      ],
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 24),
              
              // Preferences Card
              Container(
                padding: const EdgeInsets.all(20),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(20),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.1),
                      blurRadius: 10,
                      offset: const Offset(0, 5),
                    ),
                  ],
                ),
                child: Form(
                  key: _formKey,
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        'Preferences',
                        style: GoogleFonts.poppins(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                          color: Colors.brown.shade900,
                        ),
                      ),
                      const SizedBox(height: 16),
                      TextFormField(
                        controller: _budgetController,
                        keyboardType: TextInputType.number,
                        decoration: InputDecoration(
                          labelText: 'Total Budget (RM)',
                          border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
                          filled: true,
                          fillColor: Colors.grey.shade50,
                        ),
                        validator: (v) => (v == null || v.isEmpty) ? 'Enter budget' : null,
                        onChanged: (_) => setState(() {}),
                      ),
                      const SizedBox(height: 16),
                      DropdownButtonFormField<String>(
                        value: _selectedRoom,
                        items: const [
                          DropdownMenuItem(value: 'Kitchen', child: Text('Kitchen')),
                          DropdownMenuItem(value: 'Living Room', child: Text('Living Room')),
                          DropdownMenuItem(value: 'Bedroom', child: Text('Bedroom')),
                          DropdownMenuItem(value: 'Bathroom', child: Text('Bathroom')),
                        ],
                        onChanged: (v) => setState(() => _selectedRoom = v ?? 'Kitchen'),
                        decoration: InputDecoration(
                          labelText: 'Room Type',
                          border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
                          filled: true,
                          fillColor: Colors.grey.shade50,
                        ),
                      ),
                      const SizedBox(height: 16),
                      CheckboxListTile(
                        value: _ecoFriendly,
                        onChanged: (v) => setState(() => _ecoFriendly = v ?? false),
                        title: Text('Eco-friendly materials only', style: GoogleFonts.poppins()),
                        controlAffinity: ListTileControlAffinity.leading,
                        activeColor: const Color(0xFF4CAF50),
                      ),
                    ],
                  ),
                ),
              ),
              const SizedBox(height: 24),
              
              // Cost Breakdown Card
              Container(
                padding: const EdgeInsets.all(20),
                decoration: BoxDecoration(
                  color: overBudget ? Colors.red.shade50 : Colors.white,
                  borderRadius: BorderRadius.circular(20),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.1),
                      blurRadius: 10,
                      offset: const Offset(0, 5),
                    ),
                  ],
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Text(
                          'Cost Breakdown',
                          style: GoogleFonts.poppins(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                            color: Colors.brown.shade900,
                          ),
                        ),
                        if (overBudget) ...[
                          const SizedBox(width: 8),
                          Icon(Icons.warning, color: Colors.red.shade600, size: 20),
                        ],
                      ],
                    ),
                    const SizedBox(height: 16),
                    _EnhancedCostRow(label: 'Wall Paint', value: _wallPaintCost, icon: Icons.format_paint),
                    _EnhancedCostRow(label: 'Flooring', value: _flooringCost, icon: Icons.view_agenda),
                    _EnhancedCostRow(label: 'Furniture', value: _furnitureCost, icon: Icons.chair),
                    _EnhancedCostRow(label: 'Lighting', value: _lightingCost, icon: Icons.lightbulb),
                    _EnhancedCostRow(label: 'Accessories', value: _accessoriesCost, icon: Icons.home),
                    const Divider(height: 32),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        Text(
                          'Total Cost',
                          style: GoogleFonts.poppins(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                            color: Colors.brown.shade900,
                          ),
                        ),
                        Text(
                          'RM $_totalCost',
                          style: GoogleFonts.poppins(
                            fontSize: 18,
                            fontWeight: FontWeight.bold,
                            color: overBudget ? Colors.red.shade600 : const Color(0xFF4CAF50),
                          ),
                        ),
                      ],
                    ),
                    if (overBudget)
                      Container(
                        margin: const EdgeInsets.only(top: 12),
                        padding: const EdgeInsets.all(12),
                        decoration: BoxDecoration(
                          color: Colors.red.shade100,
                          borderRadius: BorderRadius.circular(8),
                        ),
                        child: Row(
                          children: [
                            Icon(Icons.warning, color: Colors.red.shade600, size: 20),
                            const SizedBox(width: 8),
                            Expanded(
                              child: Text(
                                'Over budget by RM ${_totalCost - budget}. Consider cheaper alternatives.',
                                style: GoogleFonts.poppins(
                                  color: Colors.red.shade700,
                                  fontWeight: FontWeight.w600,
                                ),
                              ),
                            ),
                          ],
                        ),
                      ),
                  ],
                ),
              ),
              const SizedBox(height: 24),
              
              // Export Button
              SizedBox(
                width: double.infinity,
                child: ElevatedButton.icon(
                  icon: const Icon(Icons.picture_as_pdf),
                  label: Text('Export Report', style: GoogleFonts.poppins(fontWeight: FontWeight.w600)),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF80CBC4),
                    foregroundColor: Colors.white,
                    padding: const EdgeInsets.symmetric(vertical: 16),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                  ),
                  onPressed: _exportReport,
                ),
              ),
            ],
            ),
          ),
        ),
      ),
    );
  }
}


