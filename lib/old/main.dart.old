class _SupplierProfileForm extends StatefulWidget {
  @override
  State<_SupplierProfileForm> createState() => _SupplierProfileFormState();
}

class _SupplierProfileFormState extends State<_SupplierProfileForm> {
  final _formKey = GlobalKey<FormState>();
  final _businessNameController = TextEditingController(text: 'Elegant Interiors Co.');
  final _emailController = TextEditingController(text: 'contact@elegantinteriors.com');
  final _phoneController = TextEditingController(text: '+60 12-345 6789');
  final _addressController = TextEditingController(text: '123 Jalan Tun Razak, Kuala Lumpur, 50400');
  final _brandingController = TextEditingController(text: 'Quality, Trust, Value');
  final _infoController = TextEditingController(text: 'Open Mon-Sat, 9am-6pm. Specializing in modern furniture and interior solutions.');

  @override
  Widget build(BuildContext context) {
    return Card(
      color: Colors.brown.shade50,
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Form(
          key: _formKey,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text('Edit Profile', style: TextStyle(fontWeight: FontWeight.bold)),
              const SizedBox(height: 12),
              TextFormField(
                controller: _businessNameController,
                decoration: const InputDecoration(labelText: 'Business Name'),
                validator: (v) => v == null || v.isEmpty ? 'Enter business name' : null,
              ),
              const SizedBox(height: 12),
              TextFormField(
                controller: _emailController,
                decoration: const InputDecoration(labelText: 'Email'),
                validator: (v) => v == null || v.isEmpty ? 'Enter email' : null,
              ),
              const SizedBox(height: 12),
              TextFormField(
                controller: _phoneController,
                decoration: const InputDecoration(labelText: 'Phone'),
                validator: (v) => v == null || v.isEmpty ? 'Enter phone number' : null,
              ),
              const SizedBox(height: 12),
              TextFormField(
                controller: _addressController,
                decoration: const InputDecoration(labelText: 'Address'),
                validator: (v) => v == null || v.isEmpty ? 'Enter address' : null,
                maxLines: 2,
              ),
              const SizedBox(height: 12),
              TextFormField(
                controller: _brandingController,
                decoration: const InputDecoration(labelText: 'Branding'),
              ),
              const SizedBox(height: 12),
              TextFormField(
                controller: _infoController,
                decoration: const InputDecoration(labelText: 'Business Info'),
                maxLines: 2,
              ),
              const SizedBox(height: 16),
              ElevatedButton(
                onPressed: () {
                  if (_formKey.currentState!.validate()) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      const SnackBar(content: Text('Profile updated (mocked)')),
                    );
                  }
                },
                child: const Text('Save Changes'),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _SupplierChangePasswordSection extends StatefulWidget {
  @override
  State<_SupplierChangePasswordSection> createState() => _SupplierChangePasswordSectionState();
}

class _SupplierChangePasswordSectionState extends State<_SupplierChangePasswordSection> {
  final _formKey = GlobalKey<FormState>();
  final _oldPwController = TextEditingController();
  final _newPwController = TextEditingController();
  final _confirmPwController = TextEditingController();
  bool _isExpanded = false;
  bool _showPassword = false;
  bool _showConfirmPassword = false;

  void _showVerificationDialog() {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Row(
          children: [
            Icon(Icons.email, color: Colors.brown.shade700),
            const SizedBox(width: 8),
            Text('Email Verification', style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 10)),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Text(
              'We\'ve sent a verification code to your email address.',
              style: GoogleFonts.poppins(),
            ),
            const SizedBox(height: 16),
            TextFormField(
              decoration: InputDecoration(
                labelText: 'Enter verification code',
                border: OutlineInputBorder(),
                prefixIcon: Icon(Icons.security, color: Colors.brown.shade700),
              ),
              keyboardType: TextInputType.number,
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: Text('Cancel', style: GoogleFonts.poppins()),
          ),
          ElevatedButton(
            onPressed: () {
              Navigator.pop(ctx);
              _showVerificationSuccessDialog();
            },
            child: Text('Verify', style: GoogleFonts.poppins(fontWeight: FontWeight.w600)),
          ),
        ],
      ),
    );
  }

  void _showVerificationSuccessDialog() {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Row(
          children: [
            Icon(Icons.check_circle, color: Colors.green, size: 24),
            const SizedBox(width: 8),
            Text('Success!', style: GoogleFonts.poppins(fontWeight: FontWeight.bold, fontSize: 16)),
          ],
        ),
        content: Text(
          'Your password has been successfully changed.',
          style: GoogleFonts.poppins(),
        ),
        actions: [
          ElevatedButton(
            onPressed: () => Navigator.pop(ctx),
            child: Text('OK', style: GoogleFonts.poppins(fontWeight: FontWeight.w600)),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Card(
      color: Colors.brown.shade50,
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            GestureDetector(
              onTap: () => setState(() => _isExpanded = !_isExpanded),
              child: Row(
                children: [
                  Icon(Icons.lock, color: Colors.brown.shade700),
                  const SizedBox(width: 8),
                  Text('Change Password', style: TextStyle(fontWeight: FontWeight.bold)),
                  const Spacer(),
                  Icon(
                    _isExpanded ? Icons.expand_less : Icons.expand_more,
                    color: Colors.brown.shade700,
                  ),
                ],
              ),
            ),
            if (_isExpanded) ...[
              const SizedBox(height: 12),
              Form(
                key: _formKey,
                child: Column(
                  children: [
                    TextFormField(
                      controller: _oldPwController,
                      decoration: InputDecoration(
                        labelText: 'Current Password',
                        prefixIcon: const Icon(Icons.lock_outline),
                        suffixIcon: IconButton(
                          icon: Icon(_showPassword ? Icons.visibility : Icons.visibility_off),
                          onPressed: () => setState(() => _showPassword = !_showPassword),
                        ),
                      ),
                      obscureText: !_showPassword,
                      validator: (v) => v == null || v.isEmpty ? 'Enter your current password' : null,
                    ),
                    const SizedBox(height: 12),
                    TextFormField(
                      controller: _newPwController,
                      decoration: InputDecoration(
                        labelText: 'New Password',
                        prefixIcon: const Icon(Icons.lock),
                        suffixIcon: IconButton(
                          icon: Icon(_showPassword ? Icons.visibility : Icons.visibility_off),
                          onPressed: () => setState(() => _showPassword = !_showPassword),
                        ),
                      ),
                      obscureText: !_showPassword,
                      validator: (v) {
                        if (v == null || v.isEmpty) return 'Enter new password';
                        if (v.length < 8) return 'Password must be at least 8 characters';
                        if (!v.contains(RegExp(r'[A-Z]'))) return 'Password must contain uppercase letter';
                        if (!v.contains(RegExp(r'[0-9]'))) return 'Password must contain number';
                        return null;
                      },
                    ),
                    const SizedBox(height: 12),
                    TextFormField(
                      controller: _confirmPwController,
                      decoration: InputDecoration(
                        labelText: 'Confirm New Password',
                        prefixIcon: const Icon(Icons.lock),
                        suffixIcon: IconButton(
                          icon: Icon(_showConfirmPassword ? Icons.visibility : Icons.visibility_off),
                          onPressed: () => setState(() => _showConfirmPassword = !_showConfirmPassword),
                        ),
                      ),
                      obscureText: !_showConfirmPassword,
                      validator: (v) => v != _newPwController.text ? 'Passwords do not match' : null,
                    ),
                    const SizedBox(height: 16),
                    ElevatedButton.icon(
                      onPressed: () {
                        if (_formKey.currentState!.validate()) {
                          _showVerificationDialog();
                        }
                      },
                      icon: const Icon(Icons.security),
                      label: Text('Change Password', style: GoogleFonts.poppins(fontWeight: FontWeight.w600)),
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.brown.shade700,
                        foregroundColor: Colors.white,
                        padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(8),
                        ),
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }
}

class _SupplierDeleteAccountSection extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Card(
      color: Colors.brown.shade50,
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text('Danger Zone', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.red)),
            const SizedBox(height: 12),
            ElevatedButton(
              style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red.shade100,
                foregroundColor: Colors.red.shade700,
              ),
              onPressed: () async {
                final confirm = await showDialog<bool>(
                  context: context,
                  builder: (ctx) => AlertDialog(
                    title: const Text('Delete Account'),
                    content: const Text('Are you sure you want to delete your account? This action cannot be undone.'),
                    actions: [
                      TextButton(
                        onPressed: () => Navigator.of(ctx).pop(false),
                        child: const Text('Cancel'),
                      ),
                      TextButton(
                        onPressed: () => Navigator.of(ctx).pop(true),
                        child: const Text('Delete'),
                      ),
                    ],
                  ),
                );
                if (confirm == true) {
                  ScaffoldMessenger.of(context).showSnackBar(
                    const SnackBar(content: Text('Account deleted (mocked)')),
                  );
                  Provider.of<AuthProvider>(context, listen: false).logout();
                }
              },
              child: const Text('Delete Account'),
            ),
          ],
        ),
      ),
    );
  }
}

// ===== SAVED DESIGN EDIT SCREEN =====
class _SavedDesignEditScreen extends StatefulWidget {
  final _SavedDesign design;
  
  const _SavedDesignEditScreen({required this.design});
  
  @override
  State<_SavedDesignEditScreen> createState() => _SavedDesignEditScreenState();
}

class _SavedDesignEditScreenState extends State<_SavedDesignEditScreen> {
  String _currentTool = 'placement'; // 'placement', 'wall_selection', 'color', 'texture'
  bool _showFurniturePanel = true;
  bool _showWallPanel = false;
  bool _showGrid = true;
  bool _wallSelectionMode = false; // New mode for selecting wall areas
  
  // Task 2.1: Furniture placement state
  List<_PlacedFurniture> _placedFurniture = [];
  _PlacedFurniture? _selectedFurniture;
  _FurnitureItem? _draggingFurniture;
  Offset? _dragPosition;
  
  // Task 3.1: Wall customization state
  Color _selectedWallColor = Colors.white;
  _WallTexture? _selectedWallTexture;
  List<_WallArea> _wallAreas = [];
  _WallArea? _selectedWallArea;
  
  // Task 4.1: Preview functionality state
  bool _showPreview = false;
  bool _showBeforeAfter = false;
  List<_DesignChange> _designChanges = [];
  int _currentChangeIndex = -1;
  
  // Mock furniture items for placement
  final List<_FurnitureItem> _furnitureItems = [
    _FurnitureItem(name: 'Modern Sofa', image: 'assets/images/furniture_sofa_modern.png', category: 'seating'),
    _FurnitureItem(name: 'Classic Chair', image: 'assets/images/furniture_chair_classic.png', category: 'seating'),
    _FurnitureItem(name: 'Coffee Table', image: 'assets/images/furniture_table_coffee.png', category: 'tables'),
    _FurnitureItem(name: 'Floor Lamp', image: 'assets/images/furniture_lamp_floor.png', category: 'lighting'),
    _FurnitureItem(name: 'Modern Bed', image: 'assets/images/furniture_bed_modern.png', category: 'bedroom'),
    _FurnitureItem(name: 'Dining Table', image: 'assets/images/furniture_table_dining.png', category: 'tables'),
  ];
  
  // Task 3.3: Comprehensive wall texture options
  final List<_WallTexture> _wallTextures = [
    // White textures
    _WallTexture(name: 'Smooth White', image: 'assets/images/wall_white_smooth.png', category: 'white'),
    _WallTexture(name: 'Textured White', image: 'assets/images/wall_white_textured.png', category: 'white'),
    _WallTexture(name: 'Matte White', image: 'assets/images/wall_white_smooth.png', category: 'white'),
    _WallTexture(name: 'Glossy White', image: 'assets/images/wall_white_smooth.png', category: 'white'),
    
    // Brick textures
    _WallTexture(name: 'Red Brick', image: 'assets/images/wall_texture_brick_red.png', category: 'texture'),
    _WallTexture(name: 'White Brick', image: 'assets/images/wall_texture_brick_white.png', category: 'texture'),
    
    // Wood textures
    _WallTexture(name: 'Oak Wood', image: 'assets/images/wall_texture_wood_oak.png', category: 'texture'),
    _WallTexture(name: 'Walnut Wood', image: 'assets/images/wall_texture_wood_walnut.png', category: 'texture'),
    
    // Stone textures
    _WallTexture(name: 'Granite Stone', image: 'assets/images/wall_texture_stone_granite.png', category: 'texture'),
    _WallTexture(name: 'Marble Stone', image: 'assets/images/wall_texture_stone_marble.png', category: 'texture'),
    
    // Other textures
    _WallTexture(name: 'Concrete', image: 'assets/images/wall_texture_concrete.png', category: 'texture'),
    _WallTexture(name: 'Plaster', image: 'assets/images/wall_texture_plaster.png', category: 'texture'),
  ];
  
  // Task 3.2: Comprehensive wall color palette
  final List<Color> _wallColors = [
    // Whites
    Colors.white,
    Colors.grey.shade50,
    Colors.grey.shade100,
    Colors.grey.shade200,
    
    // Beiges
    Colors.brown.shade50,
    Colors.brown.shade100,
    Colors.brown.shade200,
    Colors.orange.shade50,
    
    // Grays
    Colors.grey.shade300,
    Colors.grey.shade400,
    Colors.grey.shade500,
    Colors.grey.shade600,
    
    // Blues
    Colors.blue.shade50,
    Colors.blue.shade100,
    Colors.blue.shade200,
    Colors.blue.shade300,
    
    // Greens
    Colors.green.shade50,
    Colors.green.shade100,
    Colors.green.shade200,
    Colors.teal.shade100,
    
    // Pinks
    Colors.pink.shade50,
    Colors.pink.shade100,
    Colors.pink.shade200,
    Colors.red.shade100,
    
    // Yellows
    Colors.yellow.shade50,
    Colors.yellow.shade100,
    Colors.amber.shade100,
    Colors.orange.shade100,
  ];

  // Task 4.4: Enhanced save changes functionality
  void _saveChanges() {
    // Save design changes
    setState(() {
      // Apply wall color changes
      if (_selectedWallArea != null && _selectedWallColor != Colors.white) {
        final index = _wallAreas.indexWhere((w) => w.id == _selectedWallArea!.id);
        if (index != -1) {
          _wallAreas[index] = _selectedWallArea!.copyWith(color: _selectedWallColor);
        }
      }
      
      // Apply wall texture changes
      if (_selectedWallArea != null && _selectedWallTexture != null) {
        final index = _wallAreas.indexWhere((w) => w.id == _selectedWallArea!.id);
        if (index != -1) {
          _wallAreas[index] = _selectedWallArea!.copyWith(texture: _selectedWallTexture);
        }
      }
    });
    
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('Changes saved to "${widget.design.name}"'),
        action: SnackBarAction(
          label: 'Share',
          onPressed: () => _exportShareDesign(),
        ),
      ),
    );
    Navigator.pop(context);
  }

  // Task 4.6: Export/share functionality
  void _exportShareDesign() {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Export Design'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            ListTile(
              leading: const Icon(Icons.image),
              title: const Text('Save as Image'),
              onTap: () {
                Navigator.pop(ctx);
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Design saved as image')),
                );
              },
            ),
            ListTile(
              leading: const Icon(Icons.share),
              title: const Text('Share Design'),
              onTap: () {
                Navigator.pop(ctx);
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Design shared')),
                );
              },
            ),
            ListTile(
              leading: const Icon(Icons.print),
              title: const Text('Print Design'),
              onTap: () {
                Navigator.pop(ctx);
                ScaffoldMessenger.of(context).showSnackBar(
                  const SnackBar(content: Text('Design sent to printer')),
                );
              },
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('Cancel'),
          ),
        ],
      ),
    );
  }

  // AI Helper Dialog for instant chat
  void _showAIHelperDialog() {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: Row(
          children: [
            Container(
              padding: const EdgeInsets.all(8),
              decoration: BoxDecoration(
                color: const Color(0xFF80CBC4),
                borderRadius: BorderRadius.circular(8),
              ),
              child: const Icon(
                Icons.psychology,
                color: Colors.white,
                size: 20,
              ),
            ),
            const SizedBox(width: 12),
            Text(
              'AI Design Helper',
              style: GoogleFonts.poppins(
                fontWeight: FontWeight.bold,
                fontSize: 18,
              ),
            ),
          ],
        ),
        content: Container(
          width: 400,
          height: 400,
          child: Column(
            children: [
              Expanded(
                child: Container(
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    color: Colors.grey.shade50,
                    borderRadius: BorderRadius.circular(8),
                    border: Border.all(color: Colors.grey.shade300),
                  ),
                  child: SingleChildScrollView(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          'How can I help you with your design?',
                          style: GoogleFonts.poppins(
                            fontWeight: FontWeight.w600,
                            fontSize: 14,
                          ),
                        ),
                        const SizedBox(height: 12),
                        _buildAIHelperSuggestion('What furniture goes well with this style?'),
                        _buildAIHelperSuggestion('How can I improve the color scheme?'),
                        _buildAIHelperSuggestion('Suggest lighting options for this room'),
                        _buildAIHelperSuggestion('What\'s the best layout for this space?'),
                        _buildAIHelperSuggestion('How can I make this room more spacious?'),
                        _buildAIHelperSuggestion('What color palette would work best?'),
                      ],
                    ),
                  ),
                ),
              ),
              const SizedBox(height: 12),
              Row(
                children: [
                  Expanded(
                    child: TextField(
                      decoration: InputDecoration(
                        hintText: 'Ask me anything about your design...',
                        border: OutlineInputBorder(
                          borderRadius: BorderRadius.circular(8),
                        ),
                        contentPadding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                      ),
                      maxLines: 2,
                    ),
                  ),
                  const SizedBox(width: 8),
                  IconButton(
                    onPressed: () {
                      Navigator.pop(ctx);
                      ScaffoldMessenger.of(context).showSnackBar(
                        const SnackBar(content: Text('AI response: Here are some great suggestions for your design!')),
                      );
                    },
                    icon: Container(
                      padding: const EdgeInsets.all(8),
                      decoration: BoxDecoration(
                        color: const Color(0xFF80CBC4),
                        borderRadius: BorderRadius.circular(8),
                      ),
                      child: const Icon(
                        Icons.send,
                        color: Colors.white,
                        size: 20,
                      ),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }

  Widget _buildAIHelperSuggestion(String suggestion) {
    return GestureDetector(
      onTap: () {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('AI: $suggestion - Here\'s my advice...')),
        );
      },
      child: Container(
        margin: const EdgeInsets.only(bottom: 8),
        padding: const EdgeInsets.all(8),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(6),
          border: Border.all(color: Colors.grey.shade300),
        ),
        child: Text(
          suggestion,
          style: GoogleFonts.poppins(
            fontSize: 12,
            color: Colors.grey.shade700,
          ),
        ),
      ),
    );
  }

  @override
  void initState() {
    super.initState();
    // Task 3.6: Initialize wall areas
    _initializeWallAreas();
  }

  // Task 3.6: Initialize wall areas for selection with grid-based approach
  void _initializeWallAreas() {
    _wallAreas = [];
    // Start with no wall areas - users will create them by selecting grid areas
  }

  // Task 3.6: Find wall area at position
  _WallArea? _findWallAreaAtPosition(Offset position) {
    for (final wallArea in _wallAreas) {
      if (wallArea.bounds.contains(position)) {
        return wallArea;
      }
    }
    return null;
  }

  void _cancelEdit() {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Discard Changes'),
        content: const Text('Are you sure you want to discard all changes?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx),
            child: const Text('Continue Editing'),
          ),
          TextButton(
            onPressed: () {
              Navigator.pop(ctx);
              Navigator.pop(context);
            },
            child: const Text('Discard'),
          ),
        ],
      ),
    );
  }

  // AR Visualization navigation method
  void _navigateToARVisualization() {
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => _ARVisualizationScreen(design: widget.design),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF8F6F1),
      body: SafeArea(
        child: Column(
          children: [
            // Task 1.2: Edit mode header with save/cancel buttons
            _buildEditHeader(),
            
            // Task 1.3: Toolbar with placement/color/edit tools
            _buildToolbar(),
            
            // Main editing area
            Expanded(
              child: Row(
                children: [
                  // Task 1.5: Side panel for wall color/texture selection
                  if (_showWallPanel) _buildWallPanel(),
                  
                  // Main canvas area
                  Expanded(
                    child: Stack(
                      children: [
                        _buildCanvasArea(),
                        // Floating button to show furniture panel when hidden
                        if (!_showFurniturePanel)
                          Positioned(
                            bottom: 20,
                            right: 20,
                            child: FloatingActionButton(
                              onPressed: () {
                                setState(() {
                                  _showFurniturePanel = true;
                                });
                                ScaffoldMessenger.of(context).showSnackBar(
                                  const SnackBar(content: Text('Furniture panel shown')),
                                );
                              },
                              backgroundColor: const Color(0xFF80CBC4),
                              child: const Icon(Icons.chair, color: Colors.white),
                            ),
                          ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
            
            // Task 1.4: Bottom panel for furniture selection
            if (_showFurniturePanel) _buildFurniturePanel(),
          ],
        ),
      ),
    );
  }

  // Task 1.2: Edit mode header with save/cancel buttons
  Widget _buildEditHeader() {
    return Container(
      decoration: BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
          colors: [
            const Color(0xFFBCAAA4),
            const Color(0xFFD7CCC8),
            const Color(0xFFEFEBE9),
          ],
        ),
      ),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Row(
          children: [
            IconButton(
              icon: const Icon(Icons.arrow_back, color: Colors.white),
              onPressed: _cancelEdit,
            ),
            Expanded(
              child: Text(
                'Edit',
                style: GoogleFonts.poppins(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                  color: Colors.white,
                ),
              ),
            ),
            Row(
              children: [
                IconButton(
                  icon: Icon(_showPreview ? Icons.edit : Icons.visibility, color: Colors.white),
                  onPressed: () {
                    // Task 4.1: Toggle preview mode
                    setState(() {
                      _showPreview = !_showPreview;
                      if (_showPreview) {
                        _showBeforeAfter = false;
                      }
                    });
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(content: Text(_showPreview ? 'Preview mode' : 'Edit mode')),
                    );
                  },
                ),
                const SizedBox(width: 8),
                IconButton(
                  icon: const Icon(Icons.view_in_ar, color: Colors.white),
                  onPressed: () => _navigateToARVisualization(),
                ),
                const SizedBox(width: 8),
                ElevatedButton(
                  onPressed: _saveChanges,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF80CBC4),
                    foregroundColor: Colors.white,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12),
                    ),
                  ),
                  child: const Text('Save Changes'),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  // Task 1.3: Toolbar with placement/color/edit tools
  Widget _buildToolbar() {
    return Container(
      color: Colors.white,
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      child: SingleChildScrollView(
        scrollDirection: Axis.horizontal,
        child: Row(
          children: [
            _buildToolButton(
              icon: Icons.crop_free,
              label: 'Placement',
              isActive: _currentTool == 'placement',
              onTap: () => setState(() => _currentTool = 'placement'),
            ),
            const SizedBox(width: 8),
            _buildToolButton(
              icon: Icons.wallpaper,
              label: 'Wall Select',
              isActive: _currentTool == 'wall_selection',
              onTap: () => setState(() {
                _currentTool = 'wall_selection';
                _wallSelectionMode = true;
              }),
            ),
            const SizedBox(width: 8),
            _buildToolButton(
              icon: Icons.palette,
              label: 'Colors',
              isActive: _currentTool == 'color',
              onTap: () => setState(() {
                _currentTool = 'color';
                _showWallPanel = true;
              }),
            ),
            const SizedBox(width: 8),
            _buildToolButton(
              icon: Icons.texture,
              label: 'Textures',
              isActive: _currentTool == 'texture',
              onTap: () => setState(() {
                _currentTool = 'texture';
                _showWallPanel = true;
              }),
            ),

            _buildToolButton(
              icon: Icons.grid_on,
              label: 'Grid',
              isActive: _showGrid,
              onTap: () => setState(() => _showGrid = !_showGrid),
            ),
            const SizedBox(width: 8),
            _buildToolButton(
              icon: Icons.undo,
              label: 'Undo',
              isActive: _currentChangeIndex >= 0,
              onTap: () {
                // Task 4.5: Undo functionality
                _undoLastChange();
              },
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildToolButton({
    required IconData icon,
    required String label,
    required bool isActive,
    required VoidCallback onTap,
  }) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
        decoration: BoxDecoration(
          color: isActive ? const Color(0xFF80CBC4) : Colors.transparent,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(
            color: isActive ? const Color(0xFF80CBC4) : Colors.grey.shade300,
          ),
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(
              icon,
              size: 16,
              color: isActive ? Colors.white : Colors.grey.shade600,
            ),
            const SizedBox(width: 4),
            Text(
              label,
              style: GoogleFonts.poppins(
                fontSize: 12,
                fontWeight: FontWeight.w500,
                color: isActive ? Colors.white : Colors.grey.shade600,
              ),
            ),
          ],
        ),
      ),
    );
  }

  // Task 4.1: Enhanced canvas area with preview functionality
  Widget _buildCanvasArea() {
    return Container(
      margin: const EdgeInsets.all(16),
      height: 300, // Reduced height to make more space for furniture panel
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(0.1),
            blurRadius: 8,
            offset: const Offset(0, 4),
          ),
        ],
      ),
      child: GestureDetector(
        onTapDown: (details) => _handleCanvasTap(details.localPosition),
        onPanUpdate: (details) => _handleDragUpdate(details),
        onPanEnd: (details) => _handleDragEnd(),
        child: Stack(
          children: [
            // Task 4.2: Before/After comparison overlay
            if (_showPreview && _showBeforeAfter) _buildBeforeAfterOverlay(),
            
            // Room background image
            ClipRRect(
              borderRadius: BorderRadius.circular(16),
              child: Image.asset(
                widget.design.image,
                width: double.infinity,
                height: double.infinity,
                fit: BoxFit.cover,
                errorBuilder: (context, error, stackTrace) => Container(
                  color: Colors.grey.shade200,
                  child: Center(
                    child: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Icon(Icons.image, size: 60, color: Colors.grey.shade400),
                        const SizedBox(height: 16),
                        Text(
                          'Room Layout',
                          style: GoogleFonts.poppins(
                            fontSize: 18,
                            color: Colors.grey.shade600,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ),
            ),
            
            // Task 1.6: Grid overlay for precise positioning
            if (_showGrid && !_showPreview) _buildGridOverlay(),
            
            // Task 3.6: Wall areas for selection (show all created wall areas)
            if (!_showPreview) ...(_wallAreas.map((wallArea) => _buildWallArea(wallArea))),
            
            // Task 2.2: Placed furniture items
            ...(_placedFurniture.map((furniture) => _buildPlacedFurniture(furniture))),
            
            // Task 2.2: Dragging furniture preview
            if (_draggingFurniture != null && _dragPosition != null && !_showPreview)
              _buildDraggingFurniture(),
            
            // Task 4.3: 3D-like preview rendering
            if (_showPreview) _build3DPreviewOverlay(),
          ],
        ),
      ),
    );
  }

  // Task 1.6: Grid overlay for precise positioning
  Widget _buildGridOverlay() {
    return CustomPaint(
      painter: _GridPainter(),
      size: Size.infinite,
    );
  }

  // Task 3.1: Enhanced wall panel with color/texture selection
  Widget _buildWallPanel() {
    return Container(
      width: 220,
      decoration: BoxDecoration(
        color: Colors.white,
        border: Border(
          right: BorderSide(color: Colors.grey.shade300),
        ),
      ),
      child: Column(
        children: [
          // Panel header
          Container(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: Colors.grey.shade50,
              border: Border(
                bottom: BorderSide(color: Colors.grey.shade300),
              ),
            ),
            child: Row(
              children: [
                Icon(Icons.wallpaper, color: Colors.grey.shade600),
                const SizedBox(width: 8),
                Text(
                  'Wall Options',
                  style: GoogleFonts.poppins(
                    fontWeight: FontWeight.w600,
                    color: Colors.grey.shade800,
                  ),
                ),
                const Spacer(),
                IconButton(
                  icon: const Icon(Icons.close, size: 20),
                  onPressed: () => setState(() => _showWallPanel = false),
                  padding: EdgeInsets.zero,
                  constraints: const BoxConstraints(minWidth: 24, minHeight: 24),
                ),
              ],
            ),
          ),
          
          // Panel content
          Expanded(
            child: SingleChildScrollView(
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  if (_currentTool == 'color') ...[
                    _buildColorSection(),
                  ] else if (_currentTool == 'texture') ...[
                    _buildTextureSection(),
                  ],
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  // Task 3.2: Enhanced color section with color wheel palette
  Widget _buildColorSection() {
