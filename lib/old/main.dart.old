class _EnhancedBarChart extends StatelessWidget {
  final List<int> sales = const [1200, 1800, 1500, 2000, 1700, 1600, 2000];
  final List<String> months = const ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'];
  
  @override
  Widget build(BuildContext context) {
    final max = sales.reduce((a, b) => a > b ? a : b).toDouble();
    return SizedBox(
      height: 200,
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.end,
        children: List.generate(sales.length, (i) {
          final barHeight = 120 * (sales[i] / max);
          return Expanded(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.end,
              children: [
                Container(
                  height: barHeight,
                  width: 28,
                  decoration: BoxDecoration(
                    gradient: LinearGradient(
                      begin: Alignment.topCenter,
                      end: Alignment.bottomCenter,
                      colors: [
                        const Color(0xFF8B4513),
                        const Color(0xFFD2691E),
                      ],
                    ),
                    borderRadius: BorderRadius.circular(14),
                    boxShadow: [
                      BoxShadow(
                        color: Colors.black.withOpacity(0.2),
                        blurRadius: 4,
                        offset: const Offset(0, 2),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 12),
                Text(
                  months[i],
                  style: GoogleFonts.poppins(
                    fontSize: 12,
                    fontWeight: FontWeight.w600,
                    color: Colors.brown.shade700,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  'RM ${sales[i]}',
                  style: GoogleFonts.poppins(
                    fontSize: 10,
                    color: Colors.brown.shade600,
                  ),
                ),
              ],
            ),
          );
        }),
      ),
    );
  }
}

