          style: GoogleFonts.poppins(
            fontSize: 10,
            color: Colors.grey.shade600,
          ),
        ),
      ],
    );
  }

  void _selectColorFromWheel(Offset position) {
    // Calculate color based on position in wheel
    final center = const Offset(60, 60);
    final angle = (position - center).direction;
    final distance = (position - center).distance;
    
    // Convert angle to hue (0-360 degrees)
    final hue = ((angle * 180 / pi) + 360) % 360;
    
    // Convert distance to saturation (0-1)
    final maxDistance = 60.0;
    final saturation = (distance / maxDistance).clamp(0.0, 1.0);
    
    // Create color from HSV
    final color = HSVColor.fromAHSV(1.0, hue, saturation, 1.0).toColor();
    
    _selectWallColor(color);
    
    // Show feedback
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('Selected color: ${color.toString()}')),
    );
  }

  void _selectWallColor(Color color) {
    setState(() {
      _selectedWallColor = color;
    });
    
    // Apply to selected wall area
    if (_selectedWallArea != null) {
      final index = _wallAreas.indexWhere((w) => w.id == _selectedWallArea!.id);
      if (index != -1) {
        setState(() {
          _wallAreas[index] = _selectedWallArea!.copyWith(color: color);
        });
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('Applied color to ${_selectedWallArea!.id}')),
        );
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text('No wall area selected. Please select a wall first.')),
        );
      }
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('No wall area selected. Please select a wall first.')),
      );
    }
  }

