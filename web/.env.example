# ─────────────────────────────────────────────────────────────────────────────
# web/ environment reference for BOTH halves of the admin site.
#
# Each half reads its OWN file (dotenv/Vite do not walk up the tree):
#   backend/  → copy backend/.env.example → backend/.env
#   frontend/ → copy frontend/.env.example → frontend/.env.local
# Both .env files are gitignored (see web/.gitignore + the repo root
# .gitignore). Never commit real keys or the service-account JSON.
# ─────────────────────────────────────────────────────────────────────────────

# ── web/backend/.env ─────────────────────────────────────────────────────────
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=interior-design-256c5
FIREBASE_WEB_API_KEY=YOUR_WEB_API_KEY
ADMIN_UIDS=your-admin-uid-here
# Service account — pick ONE source (the JSON env var WINS; preferred on hosts
# with no secrets folder — paste the whole key JSON as the value):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
SERVICE_ACCOUNT_PATH=./secrets/service-account.json
# (alternative credential source: GOOGLE_APPLICATION_CREDENTIALS=/abs/path.json)

# ── Email verification (/verify-email/*) ─────────────────────────────────────
# Same names the old Dart server used. Missing values → send returns 503 and
# the confirm page says "Verification unavailable" (graceful, never crashes).
VERIFY_TOKEN_SECRET=long-random-string
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Intellar
PUBLIC_BASE_URL=http://localhost:4000

# ── AI design assistant (/api/ai/chat) ────────────────────────────────────────
# Google AI Studio key. SERVER-SIDE ONLY — never put it in the Flutter app or
# a --dart-define; APK contents are extractable. Paste here (or in Render →
# Environment) and restart.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
# Cheapest tier by default. If a new key cannot reach the 2.5 family, use
# GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# ── 3D generation (/api/tripo/*) ──────────────────────────────────────────────
# Tripo AI key (https://platform.tripo3d.ai → API keys). SERVER-SIDE ONLY —
# same rule as the Gemini key. This used to live in the Flutter app, which
# meant every APK shipped a copy of a paid credential.
TRIPO_API_KEY=PASTE_YOUR_NEW_TRIPO_KEY_HERE
# Tripo model version billed for image-to-model. Owned by the server so a
# version bump is one env var, not an app release.
# TRIPO_MODEL_VERSION=v3.1-20260211

# ── web/frontend/.env.local ──────────────────────────────────────────────────
# Relative path also works on the unified host (same origin): /admin/api
VITE_API_BASE_URL=http://localhost:4000/api
