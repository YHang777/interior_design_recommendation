# ─────────────────────────────────────────────────────────────────────────────
# web/ environment reference for BOTH halves of the admin site.
#
# Each half reads its OWN file (dotenv/Vite do not walk up the tree):
#   backend/  → copy backend/.env.example → backend/.env
#   frontend/ → copy frontend/.env.example → frontend/.env.local
# Both .env files are gitignored (see web/.gitignore + the repo root
# .gitignore). Never commit real keys or the service-account JSON.
# ─────────────────────────────────────────────────────────────────────────────

# ── web/backend/.env ─────────────────────────────────────────────────────────
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=interior-design-256c5
FIREBASE_WEB_API_KEY=YOUR_WEB_API_KEY
ADMIN_UIDS=your-admin-uid-here
# Service account — pick ONE source (the JSON env var WINS; preferred on Render,
# where there is no secrets folder — paste the whole key JSON as the value):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
SERVICE_ACCOUNT_PATH=./secrets/service-account.json
# (alternative credential source: GOOGLE_APPLICATION_CREDENTIALS=/abs/path.json)

# ── web/frontend/.env.local ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api
