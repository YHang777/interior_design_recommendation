{
  "name": "interior-design-admin-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Admin monitoring API for the interior-design marketplace. Mutates Firebase Auth + Firestore on behalf of the admin frontend.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/verification-token.test.ts src/routes/verify-email.routes.test.ts src/routes/ai-chat.routes.test.ts",
    "claim-admin": "tsx scripts/set-admin-claim.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
