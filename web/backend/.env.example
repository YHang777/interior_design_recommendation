# Backend environment — copy to `.env` (gitignored) and fill in.
#   cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# The ONLY browser origin allowed by CORS (the admin frontend dev server).
FRONTEND_ORIGIN=http://localhost:5173

# ── Firebase project ──────────────────────────────────────────────────────────
# Matches lib/firebase_options.dart / firebase.json at the repo root.
FIREBASE_PROJECT_ID=interior-design-256c5

# Firebase Web API key (Firebase console → Project settings → General).
# Used ONLY by the backend's login proxy (Identity Toolkit sign-in).
FIREBASE_WEB_API_KEY=YOUR_WEB_API_KEY

# ── Admin authorization ───────────────────────────────────────────────────────
# Comma-separated Firebase Auth UIDs allowed to use this API. Alternatively
# (or additionally) grant a custom claim: npm run claim-admin -- <uid>
ADMIN_UIDS=your-admin-uid-here

# ── Service account (SECRET — never commit) ───────────────────────────────────
# Option A (preferred on Render — no secrets folder needed): the WHOLE
# service-account JSON as one env var. When set, it WINS over the two below.
#   On Linux:  jq -c . service-account.json   # collapse to one line first
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
#
# Option B (local dev): path to the JSON. Relative paths resolve from
# web/backend. You can reuse the same file the Dart server uses
# (server/secrets/service-account.json) — just do not copy it into git.
# If unset, GOOGLE_APPLICATION_CREDENTIALS from the shell is used instead.
SERVICE_ACCOUNT_PATH=./secrets/service-account.json

# ── AI design assistant (/api/ai/chat) ────────────────────────────────────────
# Google AI Studio → API keys (https://aistudio.google.com).
#
# THIS KEY STAYS SERVER-SIDE. It must never be added to the Flutter app or any
# --dart-define: anything compiled into the APK can be extracted from it. The
# app sends the chat transcript to this server; this server calls Gemini.
#
# Paste your key below (or in Render → Environment), then restart the server.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
#
# Model id. The default is the cheapest tier — this assistant is short
# product/design chat, not reasoning work. If your key is new and cannot reach
# the 2.5 family (Google restricts it to earlier keys), switch to a 3.x lite:
#   GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite
