rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Users: only the owner can read/write their own profile doc ──
    //
    // Tightened for the verification feature: an owner may still manage
    // their OWN profile, but they must never be able to self-grant
    // `verificationStatus: 'verified'` — only the admin backend (Admin SDK,
    // which bypasses rules) approves suppliers. Any other status value
    // ('none' | 'pending' | 'rejected') stays writable by the owner, e.g.
    // when the app submits a verification application.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
          (!('verificationStatus' in request.resource.data) ||
           request.resource.data.verificationStatus != 'verified');
      allow update: if isOwner(uid) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['verificationStatus']) ||
           request.resource.data.verificationStatus != 'verified');
      allow delete: if isOwner(uid);
    }

    // ── Verification applications (IC + supporting documents) ──
    // Document id IS the supplier's uid. The supplier may create and read
    // ONLY their own application; nobody may update or delete it through
    // the client — the admin backend writes the review outcome (status,
    // reviewedAt, reviewedBy, reviewNote) with the Admin SDK, which bypasses
    // these rules. There is no public read: list/get as an admin console
    // user goes through the authenticated API, not the Firestore SDK.
    // The file bytes live in Storage `verification/{uid}/…` (admin-only read).
    match /verification_applications/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
          request.resource.data.uid == uid;
      allow update, delete: if false;
    }

    // ── Products: public catalogue, authenticated sellers write ──
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      // ── Reviews: public read, authenticated buyers write ──
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    // ── Orders: only participants — the customer who placed the order and
    // the suppliers fulfilling it — may read or update an order. Creation
    // must claim the ordering customer, and nobody can delete an order.
    // These rules line up with the app's queries: the customer watches
    // `orders where customerId == me` and each supplier watches
    // `orders where supplierIds array-contains me`, both of which are
    // satisfied by the per-document conditions below.
    match /orders/{orderId} {
      allow read: if signedIn() &&
          (request.auth.uid == resource.data.customerId ||
           request.auth.uid in resource.data.supplierIds);
      allow create: if signedIn() &&
          request.auth.uid == request.resource.data.customerId;
      allow update: if signedIn() &&
          (request.auth.uid == resource.data.customerId ||
           request.auth.uid in resource.data.supplierIds);
    }

    // ── Per-user cart (owner only) ──
    match /users/{uid}/cart/{productId} {
      allow read, write: if isOwner(uid);
    }

    // ── Per-user wishlist (owner only) ──
    match /users/{uid}/wishlist/{productId} {
      allow read, write: if isOwner(uid);
    }

    // ── Room designs: owner can CRUD their own designs ──
    match /room_designs/{designId} {
      allow read, update, delete: if signedIn() &&
          request.auth.uid == resource.data.userId;
      allow create: if signedIn() &&
          request.auth.uid == request.resource.data.userId;
    }
  }
}
