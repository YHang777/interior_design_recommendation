rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Users: only the owner can read/write their own profile doc ──
    //
    // Tightened for the verification feature: an owner may still manage
    // their OWN profile, but they must never be able to self-grant
    // `verificationStatus: 'verified'` — only the admin backend (Admin SDK,
    // which bypasses rules) approves suppliers. Any other status value
    // ('none' | 'pending' | 'rejected') stays writable by the owner, e.g.
    // when the app submits a verification application.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
          (!('verificationStatus' in request.resource.data) ||
           request.resource.data.verificationStatus != 'verified');
      allow update: if isOwner(uid) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['verificationStatus']) ||
           request.resource.data.verificationStatus != 'verified');
      allow delete: if isOwner(uid);
    }

    // ── Verification applications (IC + supporting documents) ──
    // Document id IS the supplier's uid. The supplier may create and read
    // ONLY their own application. The admin backend writes the review outcome
    // (status, reviewedAt, reviewedBy, reviewNote) with the Admin SDK, which
    // bypasses these rules. There is no public read: list/get as an admin
    // console user goes through the authenticated API, not the Firestore SDK.
    // The file bytes live in Storage `verification/{uid}/…` (admin-only read).
    //
    // The one update a client may make is a RE-APPLICATION: a rejected
    // supplier submits a fresh set of documents over their existing
    // application. That is a `set()` on this document, so without the update
    // rule below every re-apply fails with `permission-denied`. It is pinned
    // to the rejected → pending edge — the new status must be 'pending', so a
    // client can never write 'approved' and self-approve. Approval remains
    // admin-only.
    match /verification_applications/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
          request.resource.data.uid == uid;
      allow update: if isOwner(uid) &&
          request.resource.data.uid == uid &&
          resource.data.status == 'rejected' &&
          request.resource.data.status == 'pending';
      allow delete: if false;
    }

    // ── Products: public catalogue, authenticated sellers write ──
    //
    // `vision` is the upload-time photo verdict (labels, summary, mismatch
    // flag, admin review) — written ONLY by the backend with the Admin SDK,
    // which bypasses these rules. Without the guards below any signed-in
    // seller could stamp their own listing "photo verified" or clear a
    // mismatch flag, which is exactly what the chat's trust model rests on.
    //
    // The update guard uses `diff().affectedKeys()`, which is VALUE-based:
    // the seller's full-document save re-sends the stored `vision` map
    // unchanged (preserveStoredVision in lib/models/product.dart), and an
    // identical re-send is not an "affected" key — only an actual edit is.
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn() &&
          !('vision' in request.resource.data);
      allow update: if signedIn() &&
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['vision']);
      allow delete: if signedIn();

      // ── Reviews: public read, authenticated buyers write ──
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    // ── Orders: participants read; the backend creates and owns money;
    // suppliers advance the collection lifecycle ──
    //
    // Checkout runs entirely server-side: `createCheckoutIntent` (Admin SDK)
    // writes the unpaid order, the Stripe webhook / verify marks it paid, and
    // cancel/refund go through the backend so stock and money move together.
    // Clients therefore never create an order and never write payment state.
    //
    // The only client-side writers left are the suppliers on the order
    // (marketplace_repository.dart): they advance status and attach their own
    // invoice via field-path updates, which touch exactly
    // {status, statusHistory, invoices} — the affected-keys whitelist below.
    match /orders/{orderId} {
      // `resource` is null for a get()/snapshot on a document that does not
      // exist, and rules fail closed on `resource.data.customerId` there.
      // The order screens watch a just-placed order id and need a clean
      // "not found" instead of permission-denied, so the empty existence
      // check stays open to signed-in users. It reveals no data: list
      // queries never see `resource == null`.
      allow read: if signedIn() &&
          (resource == null ||
           request.auth.uid == resource.data.customerId ||
           request.auth.uid in resource.data.supplierIds);
      // Server-only: an order doc carries live money fields (totals,
      // paymentStatus, paymentIntentId) that a client write could forge.
      allow create: if false;
      allow update: if signedIn() &&
          request.auth.uid in resource.data.supplierIds &&
          // Terminal orders are frozen for clients: collected is final
          // paperwork, cancelled is backend-owned (refund path above).
          resource.data.status in
            ['pending', 'confirmed', 'waitingCollection'] &&
          // Suppliers may only touch lifecycle paperwork. Payment fields,
          // totals, items, customer details and refunds are backend-owned —
          // a forged `paymentStatus: 'paid'` here would unlock goods with
          // zero money in Stripe.
          request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'statusHistory', 'invoices']) &&
          // Cancellation is the backend's job (it refunds first when the
          // order is paid). A client-written 'cancelled' would skip the
          // refund and orphan the Stripe charge.
          (!request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['status']) ||
           request.resource.data.status in
             ['confirmed', 'waitingCollection', 'collected']);
      // Nobody deletes orders from a client — the backend anonymises
      // account data in place so financial history survives.
      allow delete: if false;
    }

    // ── App config: signed-in read; writes only via the admin backend ──
    // `appConfig/marketplace` holds the tax rate the admin console edits.
    // Buyers/sellers read it for checkout pricing; the Admin SDK (backend)
    // bypasses these rules for writes.
    match /appConfig/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Per-user cart (owner only) ──
    match /users/{uid}/cart/{productId} {
      allow read, write: if isOwner(uid);
    }

    // ── Per-user wishlist (owner only) ──
    match /users/{uid}/wishlist/{productId} {
      allow read, write: if isOwner(uid);
    }

    // ── Room designs: owner can CRUD their own designs ──
    match /room_designs/{designId} {
      allow read, update, delete: if signedIn() &&
          request.auth.uid == resource.data.userId;
      allow create: if signedIn() &&
          request.auth.uid == request.resource.data.userId;
    }
  }
}
