rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Users: only the owner can read/write their own profile doc ──
    //
    // Tightened for the verification feature: an owner may still manage
    // their OWN profile, but they must never be able to self-grant
    // `verificationStatus: 'verified'` — only the admin backend (Admin SDK,
    // which bypasses rules) approves suppliers. Any other status value
    // ('none' | 'pending' | 'rejected') stays writable by the owner, e.g.
    // when the app submits a verification application.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
          (!('verificationStatus' in request.resource.data) ||
           request.resource.data.verificationStatus != 'verified');
      allow update: if isOwner(uid) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['verificationStatus']) ||
           request.resource.data.verificationStatus != 'verified');
      allow delete: if isOwner(uid);
    }

    // ── Verification applications (IC + supporting documents) ──
    // Document id IS the supplier's uid. The supplier may create and read
    // ONLY their own application. The admin backend writes the review outcome
    // (status, reviewedAt, reviewedBy, reviewNote) with the Admin SDK, which
    // bypasses these rules. There is no public read: list/get as an admin
    // console user goes through the authenticated API, not the Firestore SDK.
    // The file bytes live in Storage `verification/{uid}/…` (admin-only read).
    //
    // The one update a client may make is a RE-APPLICATION: a rejected
    // supplier submits a fresh set of documents over their existing
    // application. That is a `set()` on this document, so without the update
    // rule below every re-apply fails with `permission-denied`. It is pinned
    // to the rejected → pending edge — the new status must be 'pending', so a
    // client can never write 'approved' and self-approve. Approval remains
    // admin-only.
    match /verification_applications/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
          request.resource.data.uid == uid;
      allow update: if isOwner(uid) &&
          request.resource.data.uid == uid &&
          resource.data.status == 'rejected' &&
          request.resource.data.status == 'pending';
      allow delete: if false;
    }

    // ── Products: public catalogue, authenticated sellers write ──
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      // ── Reviews: public read, authenticated buyers write ──
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    // ── Orders: only participants — the customer who placed the order and
    // the suppliers fulfilling it — may read or update an order. Creation
    // must claim the ordering customer, and nobody can delete an order.
    // These rules line up with the app's queries: the customer watches
    // `orders where customerId == me` and each supplier watches
    // `orders where supplierIds array-contains me`, both of which are
    // satisfied by the per-document conditions below.
    match /orders/{orderId} {
      // `resource` is null for a get() on a document that does not exist, and
      // rules evaluate `resource.data.customerId` on that null as an error —
      // which FAILS CLOSED (deny). `createOrder` opens its transaction with an
      // idempotency pre-read of an order id it has only just generated, so that
      // read always hit the missing-doc case, the whole transaction aborted,
      // and no order was ever written. That is why checkout appeared to be a
      // mock on both the buyer and supplier sides.
      //
      // Permit only the existence check on a missing document. The contents of
      // an EXISTING order stay participant-only below, and list queries never
      // see `resource == null`, so this widens nothing that holds data.
      allow read: if signedIn() &&
          (resource == null ||
           request.auth.uid == resource.data.customerId ||
           request.auth.uid in resource.data.supplierIds);
      allow create: if signedIn() &&
          request.auth.uid == request.resource.data.customerId &&
          // An order is created unpaid and un-invoiced. `invoices` is written
          // later, by the supplier, when they accept. Letting it through here
          // would let a buyer order with a receipt already attached.
          (!('invoices' in request.resource.data) ||
           request.resource.data.invoices.size() == 0);
      allow update: if signedIn() &&
          (request.auth.uid == resource.data.customerId ||
           request.auth.uid in resource.data.supplierIds) &&
          // Invoices are the supplier's paperwork, issued at accept time. The
          // customer is deliberately excluded: without this a buyer could
          // rewrite the receipt on their own order. Only a supplier on this
          // order may touch the map at all.
          //
          // This reads `diff().affectedKeys()`, which is VALUE-based — a write
          // that re-sends an identical `invoices` map does not count as a
          // change. That is what lets the repository keep using full-document
          // `set()` on status changes, provided it writes the stored map back
          // verbatim (`preserveStoredInvoices` in lib/models/order.dart).
          // Without that helper, a parse→serialise drift would make a buyer's
          // own Cancel look like an invoice edit and fail with
          // permission-denied.
          //
          // NOTE: this checks WHO may write the map, not WHAT they may write.
          // Closing it to "append only your own entry" needs per-key map
          // diffs, which the rules language cannot express. A supplier on the
          // order can therefore still rewrite a co-supplier's invoice value;
          // see acceptOrderAndIssueInvoice for the in-app idempotency that
          // keeps one invoice per supplier.
          (!request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['invoices']) ||
           request.auth.uid in resource.data.supplierIds);
    }

    // ── Per-user cart (owner only) ──
    match /users/{uid}/cart/{productId} {
      allow read, write: if isOwner(uid);
    }

    // ── Per-user wishlist (owner only) ──
    match /users/{uid}/wishlist/{productId} {
      allow read, write: if isOwner(uid);
    }

    // ── Room designs: owner can CRUD their own designs ──
    match /room_designs/{designId} {
      allow read, update, delete: if signedIn() &&
          request.auth.uid == resource.data.userId;
      allow create: if signedIn() &&
          request.auth.uid == request.resource.data.userId;
    }
  }
}
